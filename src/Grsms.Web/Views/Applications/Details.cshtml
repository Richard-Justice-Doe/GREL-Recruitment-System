@* One application (staff view): the applicant's details and documents as sent, the review actions the user may
   take now, and the full history including internal comments. *@
@model ApplicationDetailsDto
@{
    ViewData["Title"] = Model.ApplicationNumber;
    var download = Url.Action("Download", new { id = Model.Id })!;
}

<div class="page-header">
    <div>
        <h1>@Model.FullName <partial name="_ApplicationStatus" model="Model.Status" />
            @if (Model.IsInternal)
            {
                <span class="badge rounded-pill badge-soft-primary">GREL staff</span>
            }
        </h1>
        <p>@Model.ApplicationNumber · <a asp-controller="Vacancies" asp-action="Details" asp-route-id="@Model.VacancyId">@Model.VacancyNumber</a> @Model.JobTitle
            · @Model.DivisionName → @Model.DepartmentName</p>
    </div>
    <a asp-action="Index" asp-route-tab="all" asp-route-VacancyId="@Model.VacancyId" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>All applications for this vacancy
    </a>
</div>
@* Usability U3: what happens next, at the top of the page. *@
@{
    (bool Mine, string Title, string? Detail, string? Anchor) nextStep =
        Model.CanDecideAts ? (true, "confirm or overrule the automatic rejection", null, "screening-decision")
        : Model.CanStartReview ? (true, "start the review", "The applicant then sees \"Under review\".", "review")
        : (false, Model.Status.DisplayName(), null, null);
}
<partial name="_NextStepBanner" model="nextStep" />

<div class="row g-3">
    <div class="col-xl-7">
        <div class="card glass mb-3">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">Applicant (as sent on @Model.SubmittedAt.ToString("dd MMM yyyy HH:mm"))</h2>
                <dl class="details-grid">
                    <dt>Email</dt><dd><a href="mailto:@Model.Email">@Model.Email</a></dd>
                    <dt>Phone</dt><dd><a href="tel:@Model.Phone">@Model.Phone</a></dd>
                    <dt>Location</dt><dd>@(Model.Location ?? "—")</dd>
                    <dt>Highest education</dt><dd>@Model.HighestEducation.DisplayName()@(Model.FieldOfStudy is null ? "" : $" in {Model.FieldOfStudy}")</dd>
                    <dt>Experience</dt><dd>@Model.YearsExperience year@(Model.YearsExperience == 1 ? "" : "s")</dd>
                    <dt>Current / last job</dt><dd>@(Model.CurrentPosition ?? "—")@(Model.CurrentEmployer is null ? "" : $" at {Model.CurrentEmployer}")</dd>
                    @if (Model.LinkedInUrl is not null && Uri.TryCreate(Model.LinkedInUrl, UriKind.Absolute, out var li) && (li.Scheme == "https" || li.Scheme == "http"))
                    {
                        <dt>LinkedIn / portfolio</dt><dd class="text-break"><a href="@Model.LinkedInUrl" target="_blank" rel="noopener noreferrer">@Model.LinkedInUrl</a></dd>
                    }
                    <dt>Source</dt><dd>@Model.Source.DisplayName()@(Model.AdvertNumber is null ? "" : $" (advert {Model.AdvertNumber})")</dd>
                </dl>
                @foreach (var (title, list) in new[] { ("Skills", Model.Skills), ("Certifications", Model.Certifications) })
                {
                    <h3 class="h6 mt-3">@title</h3>
                    @if (list.Count == 0)
                    {
                        <p class="small text-body-secondary mb-0">None listed.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var item in list)
                            {
                                <span class="badge rounded-pill badge-soft-secondary fw-normal fs-6">@item</span>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @if (Model.CoverLetter is not null)
        {
            <div class="card glass mb-3">
                <div class="card-body p-4">
                    <h2 class="h6 text-uppercase text-body-secondary mb-3">Covering message</h2>
                    <div style="white-space: pre-wrap">@Model.CoverLetter</div>
                </div>
            </div>
        }

        <div class="card glass mb-3">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">Documents</h2>
                <partial name="_DocumentList" model="(Model.Documents, download)" />
            </div>
        </div>

        @* ---- Phase 15: knockout answers and what the ATS read from the CV *@
        @if (Model.KnockoutAnswers.Count > 0)
        {
            <div class="card glass mb-3">
                <div class="card-body p-4">
                    <h2 class="h6 text-uppercase text-body-secondary mb-3">Knockout questions</h2>
                    <ul class="list-unstyled small mb-0">
                        @foreach (var k in Model.KnockoutAnswers)
                        {
                            <li class="mb-1">
                                @if (k.Answer) { <i class="fa-solid fa-circle-check text-success me-1"></i><strong>Yes</strong> }
                                else { <i class="fa-solid fa-circle-xmark text-danger me-1"></i><strong>No</strong> }
                                · @k.Question
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
        @if (Model.Cv is { } cv)
        {
            <div class="card glass mb-3">
                <div class="card-body p-4">
                    <h2 class="h6 text-uppercase text-body-secondary mb-1">Read from the CV</h2>
                    <p class="small text-body-secondary">By @(cv.Reader == "ai" ? "the Claude AI reader" : "GRSMS's own reader"). CVs have no fixed layout, so check anything important against the file itself.</p>
                    @foreach (var w in cv.Warnings)
                    {
                        <div class="alert alert-warning small py-2"><i class="fa-solid fa-triangle-exclamation me-1"></i>@w</div>
                    }
                    <dl class="details-grid small">
                        <dt>Name</dt><dd>@(cv.FullName ?? "—")</dd>
                        <dt>Email</dt><dd>@(cv.Email ?? "—")@(cv.Email is not null && !string.Equals(cv.Email, Model.Email, StringComparison.OrdinalIgnoreCase) ? " (differs from the account)" : "")</dd>
                        <dt>Phone</dt><dd>@(cv.Phone ?? "—")</dd>
                        <dt>Highest education</dt><dd>@(cv.HighestEducation == EducationLevel.None ? "—" : cv.HighestEducation.DisplayName())</dd>
                        <dt>Experience</dt><dd>@(cv.YearsExperience is int y ? $"{y} year(s) from the dates below" : "—") <span class="text-body-secondary">(profile says @Model.YearsExperience)</span></dd>
                    </dl>
                    @if (cv.EmploymentHistory.Count > 0)
                    {
                        <h3 class="h6 mt-2">Employment history</h3>
                        <ul class="small mb-2">
                            @foreach (var j in cv.EmploymentHistory)
                            {
                                <li>@j.Description <span class="text-body-secondary">· @j.From.ToString("MMM yyyy") – @(j.IsCurrent ? "present" : j.To.ToString("MMM yyyy"))</span></li>
                            }
                        </ul>
                    }
                    @foreach (var (title, list) in new[] { ("Education", cv.Education), ("Skills", cv.Skills), ("Certifications", cv.Certifications) })
                    {
                        @if (list.Count > 0)
                        {
                            <h3 class="h6 mt-2">@title</h3>
                            <div class="small">@string.Join(" · ", list)</div>
                        }
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-xl-5">
        @* ---- Phase 15: the ATS decision. A held rejection is decided here (or in bulk on the ATS dashboard). *@
        @if (Model.AtsDecision != AtsDecision.None)
        {
            <div class="card glass mb-3 @(Model.CanDecideAts ? "border border-danger" : "")">
                <div class="card-body p-4">
                    <h2 id="screening-decision" class="h6 text-uppercase text-body-secondary mb-2">Screening decision: @Model.AtsDecision.DisplayName()</h2>
                    @if (Model.AtsRejectionReason is not null)
                    {
                        <div class="small mb-2" style="white-space: pre-line"><strong>Why screening rejected it:</strong>
@Model.AtsRejectionReason</div>
                    }
                    @if (Model.AtsDecisionByName is not null)
                    {
                        <div class="small text-body-secondary mb-2">@Model.AtsDecision.DisplayName() by @Model.AtsDecisionByName on @Model.AtsDecisionAt?.ToString("dd MMM yyyy HH:mm")@(Model.AtsDecisionNote is null ? "" : $": {Model.AtsDecisionNote}")</div>
                    }
                    @if (Model.CanDecideAts)
                    {
                        <p class="small mb-2">The applicant has <strong>not</strong> been told; they see "Under review". Check the CV and the scores, then decide.</p>
                        <form asp-controller="Ats" asp-action="Confirm" asp-route-id="@Model.Id" method="post" class="mb-3">
                            <input type="hidden" name="returnTo" value="application" />
                            <input type="text" name="note" class="form-control form-control-sm mb-2" maxlength="2000" placeholder="Note (optional, internal)" aria-label="Note" />
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100"
                                    data-confirm="Confirm the automatic rejection? The application becomes Not successful and the applicant is emailed.">Confirm rejection</button>
                        </form>
                        <form asp-controller="Ats" asp-action="Override" asp-route-id="@Model.Id" method="post">
                            <input type="hidden" name="returnTo" value="application" />
                            <label for="override-reason" class="form-label small">Or override: why should it be reviewed? (required, internal)</label>
                            <textarea id="override-reason" name="reason" class="form-control form-control-sm mb-2" rows="2" maxlength="2000" required
                                      placeholder="e.g. The CV shows the certificate under a different name"></textarea>
                            <button type="submit" class="btn btn-sm btn-outline-primary w-100">Override: move to Under review</button>
                        </form>
                    }
                </div>
            </div>
        }

        @* ---- Screening (the ATS since Phase 15) and shortlisting (Phase 6) *@
        @{
            var row = (ShortlistRowDto?)ViewBag.ShortlistRow;
            var s = Model.Screening;
            string? backToApplication = "application";
        }
        <div class="card glass mb-3">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 text-uppercase text-body-secondary mb-0">Screening</h2>
                    <span class="small">
                        <a asp-controller="Ats" asp-action="Vacancy" asp-route-id="@Model.VacancyId">Screening for this vacancy</a> ·
                        <a asp-controller="Shortlisting" asp-action="Vacancy" asp-route-id="@Model.VacancyId">Shortlisting board</a>
                    </span>
                </div>
                @if (s is null)
                {
                    <p class="small text-body-secondary mb-0">Not screened yet. A reviewer can run screening from the vacancy's Screening page.</p>
                }
                else
                {
                    <partial name="_AtsBreakdown" model="s" />
                }

                @if (Model.RecruiterRecommendation != ShortlistRecommendation.None || Model.HodRecommendation != ShortlistRecommendation.None)
                {
                    <hr />
                    <dl class="details-grid small mb-0">
                        <dt>Recruiter</dt><dd>@Model.RecruiterRecommendation.DisplayName()@(Model.RecruiterNote is null ? "" : $": {Model.RecruiterNote}")</dd>
                        <dt>Head of Department</dt><dd>@Model.HodRecommendation.DisplayName()@(Model.HodNote is null ? "" : $": {Model.HodNote}")</dd>
                    </dl>
                }
                @if (row is not null && (row.CanRecommend || row.CanHodReview || row.CanShortlist))
                {
                    <hr />
                    <partial name="_ShortlistActions" model="(row, Model.VacancyId, backToApplication)" />
                }
            </div>
        </div>

        @* ---- Phase 7: interviews and assessments *@
        @if (Model.Status is ApplicationStatus.Shortlisted or ApplicationStatus.Interview or ApplicationStatus.Offer or ApplicationStatus.Hired or ApplicationStatus.OfferDeclined)
        {
            <div class="card glass mb-3">
                <div class="card-body p-4">
                    <h2 class="h6 text-uppercase text-body-secondary mb-3">Interviews and assessments</h2>
                    <div class="d-grid gap-2">
                        @if (ViewBag.CanSchedule == true)
                        {
                            <a asp-controller="Interviews" asp-action="Schedule" asp-route-applicationId="@Model.Id" class="btn btn-primary btn-sm">
                                <i class="fa-solid fa-calendar-plus me-1"></i>Schedule an interview or assessment
                            </a>
                        }
                        <a asp-controller="Interviews" asp-action="Results" asp-route-id="@Model.VacancyId" class="btn btn-outline-secondary btn-sm">Interview results for this vacancy</a>
                        @if (Model.Status is not ApplicationStatus.Shortlisted)
                        {
                            <a asp-controller="Hiring" asp-action="Case" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-user-tie me-1"></i>Hiring: checks, recommendation and offer</a>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.CanStartReview || Model.CanMarkNotSuccessful)
        {
            <div class="card glass mb-3 border border-primary">
                <div class="card-body p-4">
                    <h2 id="review" class="h6 text-uppercase text-body-secondary mb-3">Review</h2>
                    @if (Model.CanStartReview)
                    {
                        <form asp-action="StartReview" asp-route-id="@Model.Id" method="post" class="mb-3">
                            <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-magnifying-glass me-1"></i>Start review</button>
                            <div class="form-text">The applicant's tracker then shows "Under review".</div>
                        </form>
                    }
                    @if (Model.CanMarkNotSuccessful)
                    {
                        <form asp-action="NotSuccessful" asp-route-id="@Model.Id" method="post">
                            <label for="reason" class="form-label small">Not taking it further? Reason (internal only, the applicant does not see it)</label>
                            <textarea id="reason" name="reason" class="form-control form-control-sm mb-2" rows="3" maxlength="2000" required
                                      placeholder="e.g. Does not meet the minimum education requirement"></textarea>
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100"
                                    data-confirm="Mark this application not successful? The applicant will be emailed.">Mark not successful</button>
                        </form>
                    }
                </div>
            </div>
        }
        else if (Model.ActionBlockedReason is not null)
        {
            <div class="alert alert-info small"><i class="fa-solid fa-circle-info me-1"></i>@Model.ActionBlockedReason</div>
        }

        @if (Model.OutcomeReason is not null)
        {
            <div class="alert alert-secondary small"><strong>Internal reason:</strong> @Model.OutcomeReason</div>
        }

        <div class="card glass">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">History</h2>
                <ul class="timeline">
                    @foreach (var h in Model.History)
                    {
                        <li>
                            <span class="tl-dot @(h.Action is ApplicationAction.NotSuccessful or ApplicationAction.Withdrawn ? "warning" : "")"></span>
                            <div><strong>@h.Action.DisplayName()</strong> by @h.ActorName</div>
                            <div class="small text-body-secondary">@h.ActionAt.ToString("dd MMM yyyy HH:mm")</div>
                            @if (h.Comments is not null)
                            {
                                <div class="tl-comment small">@h.Comments</div>
                            }
                        </li>
                    }
                </ul>
                <p class="small text-body-secondary mb-2">Department HOD: @Model.RequestingHodName</p>
                <partial name="_AuditTrailLink" model="@(("JobApplication", Model.Id))" />
            </div>
        </div>
    </div>
</div>
