@* One onboarding: the checklist (HR, department, IT, the new employee's items), the first-day details and the
   appointment letter. Each panel only shows the actions the user may take now. *@
@model OnboardingDetailsDto
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Auth
@{
    ViewData["Title"] = $"Onboarding: {Model.EmployeeName}";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var staff = ViewBag.Staff as SelectList;
    var percent = Model.Tasks.Count == 0 ? 0 : Model.TasksFinished * 100 / Model.Tasks.Count;
    string TaskCss(OnboardingTaskStatus s) => s switch
    {
        OnboardingTaskStatus.Done => "badge-soft-success",
        OnboardingTaskStatus.NotNeeded => "badge-soft-secondary",
        _ => "badge-soft-warning"
    };
    string StatusCss(OnboardingStatus s) => s switch
    {
        OnboardingStatus.Completed => "badge-soft-success",
        OnboardingStatus.Cancelled => "badge-soft-secondary",
        _ => "badge-soft-warning"
    };
    var defaultTerms = Model.LetterTerms ?? """
Probation: 6 months from the date of appointment, after which your appointment will be confirmed subject to satisfactory performance.
Working hours: 8:00 to 17:00, Monday to Friday, or as your department requires.
Annual leave, medical cover and other benefits: in line with GREL's conditions of service for your grade.
Notice: one month's notice or one month's salary in lieu, on either side, after confirmation.
""";
}

<div class="page-header">
    <div>
        <h1>Onboarding: @Model.EmployeeName <span class="badge rounded-pill @StatusCss(Model.Status) fs-6 align-middle">@Model.Status.DisplayName()</span></h1>
        <p>@Model.Number · @Model.JobTitle · @Model.DivisionName → @Model.DepartmentName · @Model.SiteName
            · starts <strong>@Model.StartDate.ToString("ddd dd MMM yyyy")</strong></p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if ((await Auth.AuthorizeAsync(User, Policies.Applications)).Succeeded)
        {
            <a asp-controller="Hiring" asp-action="Case" asp-route-id="@Model.ApplicationId" class="btn btn-outline-secondary">Hiring case</a>
        }
        <a asp-action="Letter" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="fa-regular fa-file-lines me-1"></i>Letter preview</a>
        @if (Model.PersonnelFileId is int pf)
        {
            <a asp-controller="PersonnelFiles" asp-action="Details" asp-route-id="@pf" class="btn btn-outline-secondary"><i class="fa-regular fa-folder-open me-1"></i>Personnel file</a>
        }
        else if (Model.Status == OnboardingStatus.Completed && Model.Documents is not null && (await Auth.AuthorizeAsync(User, Policies.PersonnelFiles)).Succeeded)
        {
            <form asp-action="OpenPersonnelFile" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-outline-primary"><i class="fa-regular fa-folder-open me-1"></i>Open the personnel file</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">All onboarding</a>
    </div>
</div>

@if (Model.Status == OnboardingStatus.Cancelled)
{
    <div class="alert alert-secondary">Cancelled: @Model.CancelReason</div>
}

<div class="card glass mb-3">
    <div class="card-body py-4">
        <partial name="_OnboardingStepper" model="(Model.Status, Model.History.LastOrDefault(h => h.ToStatus == OnboardingStatus.Cancelled)?.FromStatus)" />
        @if (OnboardingWorkflow.IsActive(Model.Status) && Model.ExpectedCompletionDate is { } expected)
        {
            <p class="text-center small text-body-secondary mb-0 mt-3">
                Expected to be complete by <strong>@expected.ToString("dd MMM yyyy")</strong>@(expected < today ? " (overdue)" : "").
            </p>
        }
        else if (Model.CompletedAt is { } done)
        {
            <p class="text-center small text-body-secondary mb-0 mt-3">Completed on @done.ToString("dd MMM yyyy"), staff number <strong>@Model.EmployeeNumber</strong>.</p>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-7">
        @* ---- Phase 19: the personal record declaration (HR only) *@
        @if (Model.PersonalRecordSigned is bool prSigned)
        {
            <div class="card glass mb-3">
                <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h2 class="h6 text-uppercase text-body-secondary mb-1">Personal record declaration</h2>
                        <span class="badge rounded-pill @(prSigned ? "badge-soft-success" : "badge-soft-warning")">@(prSigned ? "Signed" : "Not signed yet")</span>
                    </div>
                    <a asp-action="PersonalRecord" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary"><i class="fa-regular fa-id-card me-1"></i>Open the personal record</a>
                </div>
            </div>
        }
        @* ---- Phase 18: New-hire documents (HR only: personal documents) *@
        @if (Model.Documents is not null)
        {
            ViewData["DocController"] = "Onboarding";
            ViewData["DocRouteId"] = Model.Id;
            <div class="card glass mb-3 @(Model.Status == OnboardingStatus.AwaitingDocumentVerification ? "border border-primary" : "")">
                <div class="card-body p-4">
                    <partial name="_EmployeeDocuments" model="Model.Documents" view-data="ViewData" />
                </div>
            </div>
        }

        @* ---- Checklist *@
        <div class="card glass mb-3">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 text-uppercase text-body-secondary mb-0">Checklist and departmental induction</h2>
                    <span class="small text-body-secondary">@Model.TasksFinished of @Model.Tasks.Count finished</span>
                </div>
                <div class="progress mb-3" role="progressbar" aria-label="Checklist progress" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100" style="height: 6px">
                    <div class="progress-bar" style="width: @percent%"></div>
                </div>

                @* Phase 20: grouped by induction area (HR, IT and the other areas), with the new employee's own department (its HOD) *@
                @foreach (var team in Model.Tasks.GroupBy(t => t.Group).OrderBy(g => g.Min(t => t.Area is { } a ? (int)a : t.Team == OnboardingTeam.Department ? -1 : 99)))
                {
                    <h3 class="h6 mt-3">@team.Key@(team.First().Team == OnboardingTeam.NewEmployee ? " (to bring on the first day; tick when received)" : "")</h3>
                    @foreach (var t in team)
                    {
                        <div class="border rounded-3 p-2 mb-2 small @(t.IsOverdue ? "border-danger" : "")">
                            <div class="d-flex justify-content-between gap-2">
                                <div>
                                    <strong>@t.Title</strong>
                                    @if (t.Description is not null) { <div>@t.Description</div> }
                                    <div class="text-body-secondary">
                                        @(t.AssignedTo ?? (t.Team == OnboardingTeam.NewEmployee ? "HR ticks when received" : "Unassigned"))
                                        @if (t.AssignedAt is not null) { <span> · assigned @t.AssignedAt.Value.ToString("dd MMM")</span> }
                                        @if (t.DueDate is not null)
                                        {
                                            <span> · due @t.DueDate.Value.ToString("dd MMM")</span>
                                        }
                                        @if (t.IsOverdue) { <span class="text-danger fw-semibold"> · overdue</span> }
                                    </div>
                                    @if (t.CompletedBy is not null)
                                    {
                                        <div class="text-body-secondary">@t.Status.DisplayName() by @t.CompletedBy, @t.CompletedAt?.ToString("dd MMM yyyy")
                                            @if (t.VerifiedBy is not null) { <span>· verified by @t.VerifiedBy, @t.VerifiedAt?.ToString("dd MMM yyyy")</span> }
                                            else { <span class="text-warning">· waiting for HR to verify</span> }
                                        </div>
                                    }
                                    @if (t.Notes is not null) { <div class="mt-1">@t.Notes</div> }
                                </div>
                                <span class="badge rounded-pill @TaskCss(t.Status) align-self-start">@t.Status.DisplayName()</span>
                            </div>
                            @if (t.CanVerify)
                            {
                                <form asp-action="VerifyTask" asp-route-id="@Model.Id" method="post" class="mt-2">
                                    <input type="hidden" name="taskId" value="@t.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success"><i class="fa-solid fa-check-double me-1"></i>Verify</button>
                                </form>
                            }
                            @if (t.CanUpdate)
                            {
                                <form asp-action="UpdateTask" asp-route-id="@Model.Id" method="post" class="mt-2">
                                    <input type="hidden" name="taskId" value="@t.Id" />
                                    @if (t.Status == OnboardingTaskStatus.Open)
                                    {
                                        <div class="input-group input-group-sm">
                                            <input name="notes" class="form-control" maxlength="2000" placeholder="Notes (required for &quot;not needed&quot;)" aria-label="Notes" />
                                            <button type="submit" name="status" value="Done" class="btn btn-outline-success"><i class="fa-solid fa-check me-1"></i>Done</button>
                                            <button type="submit" name="status" value="NotNeeded" class="btn btn-outline-secondary">Not needed</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="submit" name="status" value="Open" class="btn btn-sm btn-link p-0">Reopen</button>
                                    }
                                </form>
                            }
                            @if (Model.CanManage && t.Status == OnboardingTaskStatus.Open && t.Team != OnboardingTeam.NewEmployee)
                            {
                                <details class="mt-1">
                                    <summary class="text-body-secondary">Reassign or change the due date</summary>
                                    <form asp-action="AssignTask" asp-route-id="@Model.Id" method="post" class="mt-2">
                                        <input type="hidden" name="taskId" value="@t.Id" />
                                        <div class="input-group input-group-sm">
                                            <select name="userId" class="form-select" aria-label="Responsible person">
                                                <option value="">Unassigned</option>
                                                @foreach (var s in staff ?? Enumerable.Empty<SelectListItem>())
                                                {
                                                    <option value="@s.Value" selected="@(s.Value == t.AssignedToUserId)">@s.Text</option>
                                                }
                                            </select>
                                            <input name="dueDate" type="date" class="form-control" value="@t.DueDate?.ToString("yyyy-MM-dd")" aria-label="Due date" />
                                            <button type="submit" class="btn btn-outline-primary">Save</button>
                                        </div>
                                    </form>
                                    <form asp-action="RemoveTask" asp-route-id="@Model.Id" method="post" class="mt-1">
                                        <input type="hidden" name="taskId" value="@t.Id" />
                                        <button type="submit" class="btn btn-sm btn-link text-danger p-0" data-confirm="Remove this task from the checklist?">Remove from the checklist</button>
                                    </form>
                                </details>
                            }
                        </div>
                    }
                }

                @if (Model.CanManage)
                {
                    <form asp-action="AddTask" asp-route-id="@Model.Id" method="post" class="border-top pt-3 mt-3">
                        <h3 class="h6">Add a task</h3>
                        <div class="row g-2">
                            <div class="col-md-4">
                                @* Phase 20: an induction area, or (empty) the new employee's own department *@
                                <input type="hidden" name="team" value="@OnboardingTeam.Department" />
                                <select name="area" class="form-select form-select-sm" aria-label="Induction area">
                                    <option value="">Own department (HOD)</option>
                                    @foreach (var ar in Enum.GetValues<InductionArea>())
                                    {
                                        <option value="@ar">@ar.DisplayName()</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-8">
                                <input name="title" class="form-control form-control-sm" maxlength="300" required placeholder="Task name" aria-label="Task" />
                            </div>
                            <div class="col-12">
                                <input name="description" class="form-control form-control-sm" maxlength="2000" placeholder="Description (optional)" aria-label="Description" />
                            </div>
                            <div class="col-md-5">
                                <select name="userId" class="form-select form-select-sm" aria-label="Responsible person">
                                    <option value="">Unassigned</option>
                                    @foreach (var s in staff ?? Enumerable.Empty<SelectListItem>())
                                    {
                                        <option value="@s.Value">@s.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <input name="dueDate" type="date" class="form-control form-control-sm" aria-label="Due date" />
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-sm btn-outline-primary w-100">Add task</button>
                            </div>
                        </div>
                    </form>
                }
            </div>
        </div>

        @* ---- Phase 18: history *@
        <div class="card glass mb-3">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">History</h2>
                <ul class="timeline">
                    @foreach (var h in Model.History)
                    {
                        <li>
                            <span class="tl-dot @(h.Action is OnboardingAction.Cancelled ? "danger" : h.Action is OnboardingAction.ReturnedToEmployee or OnboardingAction.ReturnedForVerification ? "warning" : "")"></span>
                            <div><strong>@h.Action.DisplayName()</strong> by @h.ActorName</div>
                            <div class="small text-body-secondary">
                                @h.ActionAt.ToString("dd MMM yyyy HH:mm")
                                @if (h.FromStatus != h.ToStatus) { <span> · @h.FromStatus.DisplayName() → @h.ToStatus.DisplayName()</span> }
                            </div>
                            @if (h.Comments is not null) { <div class="tl-comment small">@h.Comments</div> }
                        </li>
                    }
                </ul>
                <a asp-controller="AuditLogs" asp-action="Index" asp-route-entityName="OnboardingRecord" asp-route-entityId="@Model.Id" class="small">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i>Full change log (audit trail)
                </a>
            </div>
        </div>
    </div>

    <div class="col-xl-5">
        @* ---- Phase 18: the next step of the workflow *@
        @if (Model.CanManage)
        {
            <div class="card glass mb-3 border border-primary">
                <div class="card-body p-4">
                    <h2 class="h6 text-uppercase text-body-secondary mb-3">Next step: @Model.Status.DisplayName()</h2>
                    @switch (Model.Status)
                    {
                        case OnboardingStatus.Draft:
                            <p class="small mb-0">An HR Manager issues the appointment letter below. That asks the new employee to sign it and upload the new-hire documents.</p>
                            break;

                        case OnboardingStatus.AwaitingEmployeeSubmission:
                            <p class="small">Waiting for the new employee to sign the letter@(Model.LetterSignedAt is null ? "" : " (done)") and upload the documents, then submit.</p>
                            @if (Model.CanSubmitForEmployee)
                            {
                                <form asp-action="Submit" asp-route-id="@Model.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-primary" data-confirm="Submit the documents for verification on the new employee's behalf?">Submit for the new employee</button>
                                </form>
                            }
                            else if (Model.Documents?.SubmitBlockedReason is { } why)
                            {
                                <p class="small text-body-secondary mb-0">@why</p>
                            }
                            break;

                        case OnboardingStatus.AwaitingDocumentVerification:
                            <p class="small">Verify each document against the original (left), or reject it with the reason.</p>
                            @if (Model.CanReturnToEmployee)
                            {
                                <form asp-action="ReturnToEmployee" asp-route-id="@Model.Id" method="post" class="mb-2">
                                    <div class="input-group input-group-sm">
                                        <input name="comments" class="form-control" maxlength="2000" placeholder="Message (required if no document was rejected)" aria-label="Message to the new employee" />
                                        <button type="submit" class="btn btn-outline-warning" data-confirm="Send the onboarding back to the new employee to correct?">Send back to the new employee</button>
                                    </div>
                                </form>
                            }
                            @if (Model.CanMarkVerified)
                            {
                                <form asp-action="MarkVerified" asp-route-id="@Model.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-success"><i class="fa-solid fa-check-double me-1"></i>All documents verified: send to the HR Manager</button>
                                </form>
                            }
                            else if (Model.VerifiedBlockedReason is not null)
                            {
                                <p class="small text-body-secondary mb-0">@Model.VerifiedBlockedReason</p>
                            }
                            break;

                        case OnboardingStatus.AwaitingHrApproval:
                            @if (Model.CanHrDecide && User.IsInRole(Roles.HrManager))
                            {
                                <form asp-action="HrDecide" asp-route-id="@Model.Id" method="post">
                                    @* Phase 20: which departmental induction areas apply to this new employee *@
                                    <fieldset class="mb-3">
                                        <legend class="form-label small mb-1">Departmental induction areas <span class="text-body-secondary">(their tasks are added on approval)</span></legend>
                                        @foreach (var c in Model.InductionChoices)
                                        {
                                            <div class="form-check small">
                                                <input class="form-check-input" type="checkbox" name="areas" value="@c.Area" id="area-@c.Area" checked="@c.Ticked" />
                                                <label class="form-check-label" for="area-@c.Area">
                                                    <strong>@c.Area.DisplayName()</strong> <span class="text-body-secondary">· @c.Owner · @string.Join(", ", c.Tasks)</span>
                                                </label>
                                            </div>
                                        }
                                    </fieldset>
                                    <label for="hrComments" class="form-label small">Comments <span class="text-body-secondary">(required to return)</span></label>
                                    <textarea id="hrComments" name="comments" class="form-control form-control-sm mb-2" rows="2" maxlength="2000"></textarea>
                                    <div class="d-flex gap-2">
                                        <button type="submit" name="approve" value="true" class="btn btn-sm btn-success"><i class="fa-solid fa-check me-1"></i>Approve: start the induction</button>
                                        <button type="submit" name="approve" value="false" class="btn btn-sm btn-outline-warning">Return for verification</button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <p class="small text-body-secondary mb-0">@(Model.HrDecisionBlockedReason ?? "Waiting for an HR Manager to approve the onboarding.")</p>
                            }
                            break;

                        case OnboardingStatus.AwaitingDepartmentalInduction:
                            @if (Model.CanCompleteInduction)
                            {
                                <form asp-action="CompleteInduction" asp-route-id="@Model.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-success"><i class="fa-solid fa-flag-checkered me-1"></i>Induction complete: ready to activate</button>
                                </form>
                            }
                            else
                            {
                                <p class="small text-body-secondary mb-0">@Model.InductionBlockedReason</p>
                            }
                            break;

                        case OnboardingStatus.AwaitingActivation:
                            <form asp-action="Activate" asp-route-id="@Model.Id" method="post">
                                <label for="staffNumber" class="form-label small">Staff number (from payroll)</label>
                                <div class="input-group input-group-sm">
                                    <input id="staffNumber" name="staffNumber" class="form-control text-uppercase" maxlength="30" value="@Model.EmployeeNumber" required />
                                    <button type="submit" class="btn btn-success" data-confirm="Activate @Model.EmployeeName as a GREL employee? Their account becomes a staff account.">
                                        <i class="fa-solid fa-user-check me-1"></i>Activate the employee
                                    </button>
                                </div>
                                <div class="form-text">Their GRSMS account becomes a staff account (Employee role, @Model.DepartmentName, @Model.SiteName).</div>
                            </form>
                            break;
                    }
                </div>
            </div>
        }

        @* ---- Appointment letter *@
        <div class="card glass mb-3 @(Model.CanIssueLetter && Model.LetterIssuedAt is null ? "border border-primary" : "")">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">Appointment letter @Model.LetterNumber</h2>
                @if (Model.LetterSignedAt is not null)
                {
                    <p class="small mb-2"><span class="badge rounded-pill badge-soft-success">Signed</span>
                        by @Model.LetterSignedName on @Model.LetterSignedAt.Value.ToString("dd MMM yyyy HH:mm")</p>
                }
                else if (Model.LetterIssuedAt is not null)
                {
                    <p class="small mb-2"><span class="badge rounded-pill badge-soft-warning">Waiting for the new employee's signature</span><br />
                        Issued by @Model.LetterIssuedBy on @Model.LetterIssuedAt.Value.ToString("dd MMM yyyy HH:mm")</p>
                }
                else
                {
                    <p class="small text-body-secondary mb-2">Not issued yet. An HR Manager issues it.</p>
                }

                @if (Model.CanIssueLetter)
                {
                    <form asp-action="IssueLetter" asp-route-id="@Model.Id" method="post">
                        <label for="terms" class="form-label small">Conditions of appointment</label>
                        <textarea id="terms" name="terms" class="form-control form-control-sm mb-2" rows="7" maxlength="8000" required>@defaultTerms</textarea>
                        <button type="submit" class="btn btn-sm btn-primary" data-confirm="@(Model.LetterIssuedAt is null ? "Issue the letter to the new employee?" : "Send the revised letter to the new employee?")">
                            <i class="fa-solid fa-file-signature me-1"></i>@(Model.LetterIssuedAt is null ? "Issue the appointment letter" : "Issue a revised letter")
                        </button>
                    </form>
                }
            </div>
        </div>

        @* ---- First day *@
        <div class="card glass mb-3">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">First day</h2>
                @if (Model.CanManage)
                {
                    <form asp-action="UpdateFirstDay" asp-route-id="@Model.Id" method="post" class="small">
                        <div class="row g-2 mb-2">
                            <div class="col-7">
                                <label for="startDate" class="form-label small mb-0">Start date</label>
                                <input id="startDate" name="startDate" type="date" class="form-control form-control-sm" value="@Model.StartDate.ToString("yyyy-MM-dd")" disabled="@(!Model.CanEditStartDate)" />
                            </div>
                            <div class="col-5">
                                <label for="reportTime" class="form-label small mb-0">Report at</label>
                                <input id="reportTime" name="reportTime" type="time" class="form-control form-control-sm" value="@Model.ReportTime.ToString("HH:mm")" />
                            </div>
                        </div>
                        @if (!Model.CanEditStartDate) { <div class="form-text mt-0 mb-2">The start date is fixed: the letter is signed.</div> }
                        <label for="reportLocation" class="form-label small mb-0">Where</label>
                        <input id="reportLocation" name="reportLocation" class="form-control form-control-sm mb-2" maxlength="300" value="@Model.ReportLocation" required />
                        <label for="contactPersonUserId" class="form-label small mb-0">Met by</label>
                        <select id="contactPersonUserId" name="contactPersonUserId" class="form-select form-select-sm mb-2">
                            <option value="">Not decided yet</option>
                            @foreach (var s in staff ?? Enumerable.Empty<SelectListItem>())
                            {
                                <option value="@s.Value" selected="@(s.Value == Model.ContactPersonUserId)">@s.Text</option>
                            }
                        </select>
                        <label for="firstDayNotes" class="form-label small mb-0">Notes for the new employee</label>
                        <textarea id="firstDayNotes" name="firstDayNotes" class="form-control form-control-sm mb-2" rows="2" maxlength="4000">@Model.FirstDayNotes</textarea>
                        <label for="employeeNumber" class="form-label small mb-0">Staff number (from payroll)</label>
                        <input id="employeeNumber" name="employeeNumber" class="form-control form-control-sm mb-2" maxlength="30" value="@Model.EmployeeNumber" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">Save first-day details</button>
                    </form>
                }
                else
                {
                    <dl class="details-grid small mb-0">
                        <dt>When</dt><dd>@Model.StartDate.ToString("dddd dd MMM yyyy"), @Model.ReportTime.ToString("HH:mm")</dd>
                        <dt>Where</dt><dd>@Model.ReportLocation</dd>
                        <dt>Met by</dt><dd>@(Model.ContactPerson ?? "Not decided yet")</dd>
                        @if (Model.FirstDayNotes is not null) { <dt>Notes</dt><dd style="white-space: pre-wrap">@Model.FirstDayNotes</dd> }
                        <dt>Staff number</dt><dd>@(Model.EmployeeNumber ?? "—")</dd>
                    </dl>
                }
            </div>
        </div>

        @* ---- About *@
        <div class="card glass mb-3">
            <div class="card-body p-4">
                <dl class="details-grid small mb-0">
                    <dt>New employee</dt><dd>@Model.EmployeeName@(Model.EmployeeEmail is null ? "" : $" · {Model.EmployeeEmail}")</dd>
                    <dt>Salary</dt><dd>GHS @Model.MonthlySalary.ToString("N2") per month</dd>
                    <dt>Application</dt><dd>@Model.ApplicationNumber · offer @Model.OfferNumber · @Model.VacancyNumber</dd>
                    <dt>Started by</dt><dd>@Model.CreatedBy, @Model.CreatedAt.ToString("dd MMM yyyy")</dd>
                </dl>
            </div>
        </div>

        @* ---- Notes and cancel (HR) *@
        @if (Model.CanManage)
        {
            <div class="card glass mb-3">
                <div class="card-body p-4">
                    <h2 class="h6 text-uppercase text-body-secondary mb-3">HR notes</h2>
                    <form asp-action="SaveNotes" asp-route-id="@Model.Id" method="post" class="mb-3">
                        <textarea name="notes" class="form-control form-control-sm mb-2" rows="3" maxlength="4000" aria-label="HR notes (not shown to the new employee)">@Model.Notes</textarea>
                        <button type="submit" class="btn btn-sm btn-outline-primary">Save notes</button>
                    </form>
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                        <div class="input-group input-group-sm">
                            <input name="reason" class="form-control" maxlength="2000" required placeholder="Reason (e.g. did not report)" aria-label="Reason for cancelling" />
                            <button type="submit" class="btn btn-outline-danger" data-confirm="Cancel this onboarding?">Cancel onboarding</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
