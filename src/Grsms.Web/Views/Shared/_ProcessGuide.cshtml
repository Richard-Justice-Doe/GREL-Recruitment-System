@* docs/37 CR5: the process guide at the top of a record page: where it is, what's next, who owns it, since when, and whether it is
   late against the workflow targets (System settings). Built by Application/Process/ProcessGuideService. *@
@using Grsms.Application.Process
@model ProcessGuideDto
@{
    var now = DateTime.UtcNow;
    var gb = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
    var pending = Model.PendingFor(now);
    string HealthCss(ProcessHealth h) => h switch
    {
        ProcessHealth.OnTrack => "badge-soft-success",
        ProcessHealth.Approaching => "badge-soft-warning",
        ProcessHealth.Overdue => "badge-soft-danger",
        _ => "badge-soft-secondary"
    };
}
<section class="process-guide card glass mb-3" aria-label="Where this stands">
    <div class="card-body p-3 p-md-4">
        <ol class="process-timeline" aria-label="Process steps">
            @foreach (var s in Model.Stages)
            {
                <li class="pt-step is-@s.State.ToString().ToLowerInvariant()" aria-current="@(s.State == StageState.Current ? "step" : null)">
                    <span class="pt-dot" aria-hidden="true">
                        @switch (s.State)
                        {
                            case StageState.Done: <i class="fa-solid fa-check"></i> break;
                            case StageState.Stopped: <i class="fa-solid fa-xmark"></i> break;
                            case StageState.Current: <i class="fa-solid fa-circle"></i> break;
                        }
                    </span>
                    <span class="pt-label">@s.Label</span>
                    @if (s.At is { } at) { <span class="pt-date">@at.ToString("d MMM", gb)</span> }
                    <span class="visually-hidden">(@s.State)</span>
                </li>
            }
        </ol>

        <div class="process-status mt-3">
            <div class="ps-cell ps-next">
                <div class="ps-label">@(Model.Finished ? "Done" : Model.Stopped ? "Stopped" : "Next action")</div>
                <div class="ps-value fw-semibold">@Model.NextAction</div>
            </div>
            @if (!Model.Finished && !Model.Stopped)
            {
                <div class="ps-cell">
                    <div class="ps-label">Current owner</div>
                    <div class="ps-value">@Model.Owner@if (Model.OwnerNames.Count > 0) { <span class="text-body-secondary">: @string.Join(", ", Model.OwnerNames.Take(4))@(Model.OwnerNames.Count > 4 ? $" +{Model.OwnerNames.Count - 4}" : "")</span> }</div>
                </div>
                @if (Model.NextApprover is not null)
                {
                    <div class="ps-cell">
                        <div class="ps-label">Next approver</div>
                        <div class="ps-value">@Model.NextApprover</div>
                    </div>
                }
                @if (pending is not null)
                {
                    <div class="ps-cell">
                        <div class="ps-label">Pending for</div>
                        <div class="ps-value">@pending
                            @if (Model.Health != ProcessHealth.None)
                            {
                                <span class="badge rounded-pill @HealthCss(Model.Health) ms-1" title="Target: @Model.TargetWorkingDays working day(s), System settings → Workflow targets">
                                    <i class="fa-solid @(Model.Health == ProcessHealth.Overdue ? "fa-triangle-exclamation" : Model.Health == ProcessHealth.Approaching ? "fa-hourglass-half" : "fa-circle-check") me-1"></i>@Model.Health.DisplayName()
                                </span>
                            }
                        </div>
                    </div>
                }
                @if (Model.DueDate is { } due)
                {
                    <div class="ps-cell">
                        <div class="ps-label">Expected by</div>
                        <div class="ps-value @(due < DateOnly.FromDateTime(now) ? "text-danger fw-semibold" : "")">@due.ToString("ddd d MMM yyyy", gb)</div>
                    </div>
                }
            }
        </div>

        @if (Model.LastAction is { } last)
        {
            <div class="process-followup small text-body-secondary mt-2">
                <i class="fa-solid fa-clock-rotate-left me-1"></i>Last action: <strong>@last.What</strong> by @last.Who, @last.At.ToString("d MMM yyyy HH:mm", gb) GMT
            </div>
        }
    </div>
</section>
