@* 13 November 2026: the offer letter for staff, exactly as the candidate sees it: the draft before sending, or the offer sent. *@
@using Grsms.Domain.Hiring
@model Grsms.Application.Hiring.MyOfferDto
@inject Grsms.Application.Common.Interfaces.IPdfRenderer Pdf
@{
    ViewData["Title"] = $"Offer letter {Model.Number}";
    var isDraft = Model.Status == OfferStatus.Draft;
}

<div class="page-header d-print-none">
    <div>
        <h1>Offer letter @Model.Number</h1>
        <p>@Model.CandidateName · <strong>@Model.Status.DisplayName()</strong></p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" data-print><i class="fa-solid fa-print me-1"></i>Print</button>
        @if (Pdf.IsAvailable) { <a asp-action="OfferPdf" asp-route-id="@ViewBag.ApplicationId" class="btn btn-outline-primary"><i class="fa-solid fa-file-pdf me-1"></i>Download PDF</a> }
        <a asp-action="Case" asp-route-id="@ViewBag.ApplicationId" asp-fragment="send-offer" class="btn btn-outline-secondary">Back to the hiring case</a>
    </div>
</div>

@if (isDraft)
{
    <div class="alert alert-warning d-print-none"><i class="fa-solid fa-pen-to-square me-1"></i><strong>Draft, not sent.</strong> The candidate can't see it yet. Change it or send it from the hiring case. The date on the letter becomes the day it is sent.</div>
}

<div class="row g-3">
    <div class="col-xl-8">
        <partial name="_OfferLetter" model="Model" />
    </div>
</div>
