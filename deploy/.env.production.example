# GRSMS production settings. Copy this file to deploy/.env on the server and fill it in.
# deploy/.env holds passwords: it is ignored by git; keep it readable only by the administrators.
# Full explanation: docs/21-production-deployment.md

# ---- Address
# The name people type, e.g. recruitment.grel.com.gh (DNS must point to this server).
GRSMS_DOMAIN=recruitment.grel.example
# Certificates: leave empty for an automatic Let's Encrypt certificate (needs a public name and ports 80/443 open
# to the internet); "tls internal" for an intranet-only name; or GREL's own certificate files in deploy/certs:
#   GRSMS_TLS=tls /certs/grsms.crt /certs/grsms.key
GRSMS_TLS=
HTTP_PORT=80
HTTPS_PORT=443

# ---- Database (choose long random passwords; they cannot be changed later without recreating the database)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ---- First administrator (only used the very first time; remove SEED_ADMIN_PASSWORD after the first sign-in)
SEED_ADMIN_EMAIL=hr.admin@grel.example
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULLNAME=HR Administrator

# ---- Email (from GREL IT). Empty SMTP_HOST = emails are only saved as files.
EMAIL_FROM=recruitment@grel.example
EMAIL_FROM_NAME=GREL Recruitment
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=

# ---- Microsoft 365 sign-in (optional, from GREL IT)
AZUREAD_TENANT_ID=
AZUREAD_CLIENT_ID=
AZUREAD_CLIENT_SECRET=

# ---- Text messages (off until GREL has an SMS account; see docs/06-configuration.md)
SMS_ENABLED=false
SMS_SENDER_ID=GREL
SMS_CLIENT_ID=
SMS_CLIENT_SECRET=

# ---- Backups
BACKUP_FOLDER=./backups
BACKUP_HOUR_GMT=1
BACKUP_KEEP_DAYS=30

# ---- Advanced
# Docker network for the containers. Change only if it clashes with a GREL network.
GRSMS_SUBNET=172.29.13.0/24
# Version label for the built image (e.g. 1.0.0), so a previous version can be started again.
GRSMS_VERSION=latest
APPLY_MIGRATIONS=true
