@* =====================================================================
   Main layout for signed-in users: sidebar on the left, top bar with the
   page title, theme toggle and user menu, then the page content.
   Pages set ViewData["Title"] for the browser tab and top bar.
   ===================================================================== *@
@using Microsoft.AspNetCore.Authorization
@inject NavCounts Nav
@inject IAuthorizationService Auth
@{
    var fullName = User.FindFirst(AppClaimsPrincipalFactory.FullNameClaim)?.Value ?? User.Identity?.Name ?? "";
    var initials = string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    var counts = await Nav.GetAsync();

    // The role shown under the name in the top bar: the most senior one the user holds.
    string[] rolePriority = [Roles.SuperAdmin, Roles.Admin, Roles.ManagingDirector, Roles.HrManager, Roles.HrAdministrator,
        Roles.RecruitmentOfficer, Roles.HeadOfDepartment, Roles.PanelMember, Roles.Employee, Roles.Candidate];
    var roleLabel = rolePriority.FirstOrDefault(User.IsInRole) ?? "";

    // The top-bar search looks in recruitment requests, or in vacancies for users who cannot see requests.
    var searchRequests = (await Auth.AuthorizeAsync(User, Policies.RecruitmentRequests)).Succeeded;
    var searchVacancies = !searchRequests && (await Auth.AuthorizeAsync(User, Policies.Vacancies)).Succeeded;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/images/grel-icon-32.png" />
    <title>@ViewData["Title"] · GREL Recruitment</title>
    <script src="~/js/theme-init.js"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/motion.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-path-base="@Context.Request.PathBase">
<div class="app-shell">
    <partial name="_Sidebar" />
    <div class="sidebar-backdrop" data-sidebar-toggle></div>

    <div class="app-main">
        <header class="topbar">
            <button type="button" class="icon-btn d-lg-none" data-sidebar-toggle aria-label="Open menu">
                <i class="fa-solid fa-bars"></i>
            </button>
            <h1 class="page-title text-truncate">@ViewData["Title"]</h1>

            @if (searchRequests || searchVacancies)
            {
                <form class="topbar-search d-none d-md-flex" method="get" role="search"
                      asp-controller="@(searchRequests ? "RecruitmentRequests" : "Vacancies")" asp-action="Index">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    @if (searchRequests)
                    {
                        <input type="hidden" name="tab" value="all" />
                    }
                    else
                    {
                        <input type="hidden" name="Tab" value="all" />
                    }
                    <input type="search" name="Search" class="form-control" maxlength="100"
                           placeholder="@(searchRequests ? "Search requests by number or position..." : "Search vacancies...")"
                           aria-label="Search" />
                </form>
            }

            <div class="ms-auto d-flex align-items-center gap-2">
                @* Phase 10: the bell lists my notifications (everyone, candidates too). Tasks stay on the Home page. *@
                <a asp-controller="Notifications" asp-action="Index" class="icon-btn position-relative"
                   title="@(counts.UnreadNotifications == 0 ? "Notifications" : $"{counts.UnreadNotifications} unread notification(s)")"
                   aria-label="@(counts.UnreadNotifications == 0 ? "Notifications" : $"{counts.UnreadNotifications} unread notifications")">
                    <i class="fa-regular fa-bell"></i>
                    @if (counts.UnreadNotifications > 0)
                    {
                        <span class="bell-count">@(counts.UnreadNotifications > 99 ? "99+" : counts.UnreadNotifications.ToString())</span>
                    }
                </a>
                <button type="button" class="icon-btn" data-theme-toggle title="Switch light / dark mode" aria-label="Switch light or dark mode">
                    <i data-theme-icon class="fa-solid fa-moon"></i>
                </button>

                <div class="dropdown">
                    <button type="button" class="user-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Your account: @fullName">
                        <span class="avatar">@initials</span>
                        <span class="user-name">
                            <strong>@fullName</strong>
                            @if (roleLabel.Length > 0)
                            {
                                <span>@roleLabel</span>
                            }
                        </span>
                        <i class="fa-solid fa-chevron-down small"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li><span class="dropdown-item-text small text-body-secondary">@User.Identity?.Name</span></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="fa-regular fa-id-card me-2"></i>My profile</a></li>
                        @if (!User.IsInRole(Roles.Candidate))
                        {
                            @* Usability U1: a staff member's own job search and probation (they left the sidebar). *@
                            <li><a class="dropdown-item" asp-controller="MyProbation" asp-action="Index"><i class="fa-solid fa-seedling me-2"></i>My probation</a></li>
                            <li><a class="dropdown-item" asp-controller="Careers" asp-action="Index"><i class="fa-solid fa-magnifying-glass me-2"></i>Job openings</a></li>
                            <li><a class="dropdown-item" asp-controller="MyApplications" asp-action="Index"><i class="fa-regular fa-paper-plane me-2"></i>My applications</a></li>
                        }
                        <li><a class="dropdown-item" asp-controller="MyAuditTrail" asp-action="Index"><i class="fa-solid fa-clock-rotate-left me-2"></i>My audit trail</a></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="fa-solid fa-key me-2"></i>Change password</a></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item"><i class="fa-solid fa-right-from-bracket me-2"></i>Sign out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="app-content">
            <partial name="_Alerts" />
            <partial name="_Breadcrumb" />
            @RenderBody()
        </main>

        <footer class="app-footer">
            &copy; @DateTime.Now.Year GREL · Recruitment &amp; Selection Management System
        </footer>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/datatables/dataTables.min.js"></script>
<script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
<script src="~/lib/sweetalert2/dist/sweetalert2.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/ai-panel.js" asp-append-version="true"></script>
<script src="~/js/document-preview.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
