@* The bell: my notifications, newest first. Each one matches an email sent to me. *@
@model IReadOnlyList<Grsms.Application.Notifications.NotificationDto>
@{
    ViewData["Title"] = "Notifications";
    var unread = Model.Count(n => !n.IsRead);
}

<div class="page-header">
    <div>
        <h1>Notifications</h1>
        <p>@(unread == 0 ? "You are up to date." : $"{unread} unread.") Each notification is also sent to you by email.</p>
    </div>
    @if (unread > 0)
    {
        <form asp-action="MarkAllRead" method="post">
            <button type="submit" class="btn btn-outline-secondary"><i class="fa-solid fa-check-double me-1"></i>Mark all as read</button>
        </form>
    }
</div>

<div class="card glass">
    <div class="list-group list-group-flush">
        @if (Model.Count == 0)
        {
            <div class="list-group-item text-center text-body-secondary py-4 bg-transparent">No notifications yet.</div>
        }
        @foreach (var n in Model)
        {
            <a asp-action="Open" asp-route-id="@n.Id" class="list-group-item list-group-item-action bg-transparent py-3 @(n.IsRead ? "" : "fw-semibold")">
                <div class="d-flex justify-content-between gap-3">
                    <span>
                        @if (!n.IsRead) { <span class="badge rounded-pill bg-primary me-1" aria-label="Unread">&nbsp;</span> }
                        @n.Title
                    </span>
                    <small class="text-body-secondary text-nowrap fw-normal">@n.CreatedAt.ToString("dd MMM HH:mm")</small>
                </div>
                @if (n.Body is not null)
                {
                    <div class="small text-body-secondary fw-normal mt-1">@n.Body</div>
                }
            </a>
        }
    </div>
</div>
