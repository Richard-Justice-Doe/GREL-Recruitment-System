@* 12 November 2026 (docs/34 quick win): the organisation chart, from the employees' line managers. *@
@model IReadOnlyList<OrgNodeDto>
@{
    ViewData["Title"] = "Organisation chart";
    var total = Model.Sum(n => 1 + n.TeamSize);
}

<div class="page-header">
    <div>
        <h1>Organisation chart</h1>
        <p>Who reports to whom, from each employee's line manager (the Head of Department when none is set). Change a line manager with <em>Update job details</em> on the employee.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i>All employees</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <select name="departmentId" asp-items="ViewBag.DepartmentList" class="form-select" aria-label="Department" data-auto-submit>
            <option value="">All departments</option>
        </select>
    </div>
</form>

<div class="card glass">
    <div class="card-body p-4">
        @if (Model.Count == 0)
        {
            <p class="text-body-secondary mb-0">No employees here yet. Employees appear when an onboarding is activated or when HR registers them.</p>
        }
        else
        {
            <p class="small text-body-secondary">@total @(total == 1 ? "person" : "people")</p>
            <ul class="org-chart">
                @foreach (var n in Model)
                {
                    <partial name="_OrgNode" model="n" />
                }
            </ul>
        }
    </div>
</div>
