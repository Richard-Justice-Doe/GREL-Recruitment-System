@* docs/36 AI-3: the executive dashboard. Every figure is computed by GRSMS from the live records; the written summary (AI) only
   words those figures. Trends compare with the same point of the previous quarter. *@
@using Grsms.Application.Dashboard
@model ExecutiveDashboardDto
@{
    ViewData["Title"] = "Executive dashboard";
    var gb = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
    var maxHead = Math.Max(1, Model.Departments.Select(d => d.Headcount).DefaultIfEmpty(0).Max());
    var topRate = Model.Departments.Where(d => d.OpenPositions > 0).OrderByDescending(d => d.VacancyRate).FirstOrDefault();
}

<div class="page-header">
    <div>
        <h1>Executive dashboard</h1>
        <p>@Model.QuarterLabel to @Model.Today.ToString("d MMMM yyyy", gb) · trends compare with @Model.ComparedWith.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-chart-column me-1"></i>All reports</a>
        <button type="button" class="btn btn-outline-secondary" data-print><i class="fa-solid fa-print me-1"></i>Print</button>
    </div>
</div>

@if (Model.AiOn)
{
    <form class="mb-3">
        @Html.AntiForgeryToken()
        <div class="ai-panel exec-summary" data-ai-endpoint="@Url.Action("Summary")" data-ai-auto
             data-ai-done-note="Written by AI from the figures below (totals only, no names). Check anything important against the figures.">
            <div class="d-flex align-items-center gap-2">
                <div class="ai-panel-title"><i class="fa-solid fa-wand-magic-sparkles text-primary"></i>Summary</div>
                <button type="button" class="btn btn-sm btn-outline-secondary ms-auto d-print-none" data-ai-run data-ai-regenerate><i class="fa-solid fa-rotate me-1"></i>Rewrite</button>
            </div>
            <div class="small mt-2" data-ai-status aria-live="polite"></div>
            <div class="mt-2" data-ai-result></div>
        </div>
    </form>
}

@{
    async Task Kpis(string title, string icon, IReadOnlyList<ExecutiveKpi> kpis)
    {
        <h2 class="h6 text-uppercase text-body-secondary mt-4 mb-2"><i class="fa-solid @icon me-1"></i>@title</h2>
        <div class="kpi-grid">
            @foreach (var k in kpis)
            {
                var change = k.ChangePercent;
                var good = change is null || k.HigherIsBetter is null || change == 0 ? (bool?)null : (change > 0) == k.HigherIsBetter;
                <section class="dash-card kpi-card" data-kpi="@k.Key">
                    <header class="kpi-head">
                        @if (k.Controller is not null)
                        {
                            <a href="@(Url.Action(k.Action, k.Controller) + (k.RouteQuery is null ? "" : "?" + k.RouteQuery))" class="stretched-link text-reset text-decoration-none">@k.Label</a>
                            <i class="fa-solid fa-chevron-right kpi-go"></i>
                        }
                        else
                        {
                            <span>@k.Label</span>
                        }
                    </header>
                    <div class="kpi-figure">
                        <span class="kpi-value">@k.Value.ToString("N0", gb)@(k.Unit == "%" ? " %" : "")</span>
                        @if (k.Unit is not ("" or "%")) { <span class="small text-body-secondary">@k.Unit</span> }
                        @if (k.Previous is { } p)
                        {
                            <span class="kpi-trend @(good is null ? "flat" : good == true ? "up" : "down")"
                                  title="Same point last quarter: @p.ToString("N0", gb)@(k.Unit == "" ? "" : " " + k.Unit)">
                                <i class="fa-solid @(change is null or 0 ? "fa-minus" : change > 0 ? "fa-arrow-trend-up" : "fa-arrow-trend-down")"></i>
                                @(change is { } c ? $"{(c > 0 ? "+" : "")}{c} %" : $"was {p.ToString("N0", gb)}")
                            </span>
                        }
                    </div>
                    <div class="kpi-note">@k.Hint</div>
                </section>
            }
        </div>
        await Task.CompletedTask;
    }
}

@{ await Kpis("Recruitment", "fa-magnifying-glass", Model.Recruitment); }
@{ await Kpis("Onboarding and probation", "fa-door-open", Model.Onboarding); }
@{ await Kpis("Workforce", "fa-people-group", Model.Workforce); }

<h2 class="h6 text-uppercase text-body-secondary mt-4 mb-2"><i class="fa-solid fa-sitemap me-1"></i>Departments</h2>
<div class="dash-card">
    @if (Model.Departments.Count == 0)
    {
        <div class="dash-empty">No employees or open positions yet.</div>
    }
    else
    {
        @if (topRate is not null)
        {
            <p class="small mb-3"><i class="fa-solid fa-circle-exclamation text-warning me-1"></i>Highest vacancy rate: <strong>@topRate.Department</strong>, @topRate.OpenPositions open position@(topRate.OpenPositions == 1 ? "" : "s") (@topRate.VacancyRate.ToString("0.#", gb) %).</p>
        }
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Department</th><th style="width:40%">Headcount</th><th class="text-end">Positions to fill</th><th class="text-end">Vacancy rate</th></tr></thead>
                <tbody>
                @foreach (var f in Model.Departments)
                {
                    <tr class="@(f == topRate ? "table-warning" : "")">
                        <td>@f.Department</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="report-bar-track flex-grow-1"><span class="report-bar" style="width:@((int)Math.Round(f.Headcount * 100.0 / maxHead))%"></span></div>
                                <span class="report-bar-value small">@f.Headcount</span>
                            </div>
                        </td>
                        <td class="text-end">@f.OpenPositions</td>
                        <td class="text-end">@(f.OpenPositions == 0 ? "—" : f.VacancyRate.ToString("0.#", gb) + " %")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <p class="small text-body-secondary mt-2 mb-0">Vacancy rate = positions to fill ÷ (headcount + positions to fill). Headcount counts employees registered on GRSMS.</p>
    }
</div>
