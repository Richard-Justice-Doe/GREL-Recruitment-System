{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Navigation": {
    "CountsCacheSeconds": 30
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SlowQueryMilliseconds": 500
  },
  "SeedAdmin": {
    "Email": "",
    "Password": "",
    "FullName": "System Administrator"
  },
  "Security": {
    "SessionTimeoutMinutes": 20,
    "SignInAttemptsPerMinute": 10
  },
  "AzureAd": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc"
  },
  "Email": {
    "FromAddress": "noreply@grsms.local",
    "FromName": "GREL Recruitment",
    "SmtpHost": "",
    "SmtpPort": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "PickupDirectory": "App_Data/mail"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Logs": {
    "Folder": "logs"
  },
  "DataProtection": {
    "KeysFolder": "App_Data/keys"
  },
  "App": {
    "BaseUrl": ""
  },
  "Storage": {
    "RootFolder": "App_Data/uploads"
  },
  "Uploads": {
    "MaxFileSizeMb": 10
  },
  "Vacancies": {
    "AutoClose": true,
    "AutoCloseIntervalMinutes": 60
  },
  "Reminders": {
    "Enabled": true,
    "FromHourGmt": 7,
    "ApprovalWaitingDays": 3
  },
  "Sms": {
    "Enabled": false,
    "Provider": "Hubtel",
    "SenderId": "GREL",
    "ClientId": "",
    "ClientSecret": "",
    "ApiUrl": "https://smsc.hubtel.com/v1/messages/send",
    "PickupDirectory": "App_Data/sms"
  },
  "AllowedHosts": "*"
}
