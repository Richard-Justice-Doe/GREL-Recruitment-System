@* "My profile": the person's job-seeker details, CV and certificates, used for every application they send.
   Each application keeps its own copy, so changing the profile later never changes an application already sent. *@
@model ProfileFormDto
@{
    ViewData["Title"] = "My profile";
    var returnUrl = (string?)ViewBag.ReturnUrl;
    var educationLevels = Enum.GetValues<EducationLevel>().Where(e => e != EducationLevel.None);
}

<div class="page-header">
    <div>
        <h1>My profile</h1>
        <p>Your details, CV and certificates, sent with each job application.</p>
    </div>
    @if (returnUrl is not null)
    {
        <a href="@returnUrl" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i>Back to my application</a>
    }
</div>

@if (Model.Missing.Count > 0)
{
    <div class="alert alert-warning small">
        <i class="fa-solid fa-circle-exclamation me-1"></i>
        Before you can apply, add <strong>@string.Join(", ", Model.Missing)</strong>.
    </div>
}
else
{
    <div class="alert alert-success small"><i class="fa-solid fa-circle-check me-1"></i>Your profile is ready. You can apply for vacancies.</div>
}

<div class="row g-3">
    <div class="col-xl-8">
        <form asp-action="Index" asp-route-returnUrl="@returnUrl" method="post" novalidate class="card glass">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <h2 class="h6 text-uppercase text-body-secondary mb-3">Contact</h2>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Name</label>
                        <input class="form-control" value="@Model.FullName" disabled />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input class="form-control" value="@Model.Email" disabled />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" autocomplete="tel" placeholder="e.g. 024 123 4567" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Takoradi" />
                    </div>
                </div>

                <h2 class="h6 text-uppercase text-body-secondary mb-3">Education and experience</h2>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="HighestEducation" class="form-label"></label>
                        <select asp-for="HighestEducation" class="form-select">
                            <option value="">Choose…</option>
                            @foreach (var e in educationLevels)
                            {
                                <option value="@e" selected="@(Model.HighestEducation == e)">@e.DisplayName()</option>
                            }
                        </select>
                        <span asp-validation-for="HighestEducation" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FieldOfStudy" class="form-label"></label>
                        <input asp-for="FieldOfStudy" class="form-control" placeholder="e.g. Mechanical Engineering" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="YearsExperience" class="form-label"></label>
                        <input asp-for="YearsExperience" type="number" min="0" max="60" class="form-control" />
                        <span asp-validation-for="YearsExperience" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CurrentEmployer" class="form-label"></label>
                        <input asp-for="CurrentEmployer" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CurrentPosition" class="form-label"></label>
                        <input asp-for="CurrentPosition" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Skills" class="form-label"></label>
                        <textarea asp-for="Skills" class="form-control" rows="5" placeholder="Risk assessment&#10;AutoCAD&#10;Team leadership"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Certifications" class="form-label"></label>
                        <textarea asp-for="Certifications" class="form-control" rows="5" placeholder="NEBOSH IGC&#10;First Aid"></textarea>
                    </div>
                </div>

                <h2 class="h6 text-uppercase text-body-secondary mb-3">More about you</h2>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="LinkedInUrl" class="form-label"></label>
                        <input asp-for="LinkedInUrl" class="form-control" placeholder="https://www.linkedin.com/in/…" />
                        <span asp-validation-for="LinkedInUrl" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Summary" class="form-label"></label>
                        <textarea asp-for="Summary" class="form-control" rows="4" maxlength="2000"></textarea>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary mt-4"><i class="fa-solid fa-floppy-disk me-1"></i>Save profile</button>
            </div>
        </form>
    </div>

    <div class="col-xl-4">
        <div class="card glass">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">CV and certificates</h2>
                @if (Model.Documents.Count == 0)
                {
                    <p class="small text-body-secondary">No documents yet. Upload your CV (required to apply) and any certificates.</p>
                }
                <ul class="list-unstyled mb-3">
                    @foreach (var d in Model.Documents.OrderBy(d => d.Category).ThenBy(d => d.FileName))
                    {
                        <li class="d-flex align-items-start gap-2 py-2 border-bottom">
                            <i class="fa-regular @(d.ContentType == "application/pdf" ? "fa-file-pdf" : "fa-file-lines") fa-lg mt-1"></i>
                            <div class="flex-grow-1 text-break">
                                <a asp-action="Download" asp-route-attachmentId="@d.Id" class="fw-semibold text-decoration-none">@d.FileName</a>
                                <partial name="_PreviewButton" model='((string?)Url.Action("Download", new { attachmentId = d.Id }), (string?)d.FileName)' />
                                <div class="small text-body-secondary">@d.Category.DisplayName() · @d.UploadedAt.ToString("dd MMM yyyy")</div>
                            </div>
                            <form asp-action="RemoveDocument" asp-route-returnUrl="@returnUrl" method="post">
                                <input type="hidden" name="attachmentId" value="@d.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove" data-confirm="Remove @d.FileName?"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </li>
                    }
                </ul>

                <form asp-action="Upload" asp-route-returnUrl="@returnUrl" method="post" enctype="multipart/form-data">
                    <div class="mb-2">
                        <label for="category" class="form-label small">Type</label>
                        <select id="category" name="category" class="form-select form-select-sm">
                            <option value="@AttachmentCategory.Cv">CV (replaces your current CV)</option>
                            <option value="@AttachmentCategory.Certificate">Certificate</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <input type="file" name="file" class="form-control form-control-sm" accept="@AttachmentService.AcceptList" required aria-label="File" />
                        <div class="form-text">PDF or Word preferred. Up to 10 MB.</div>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="fa-solid fa-upload me-1"></i>Upload</button>
                </form>
            </div>
        </div>

        @* docs/34 (12 November 2026): opt-in job alerts. *@
        @if (ViewBag.JobAlert is JobAlertDto alert)
        {
            <div class="card glass mt-3">
                <div class="card-body p-4">
                    <h2 class="h6 text-uppercase text-body-secondary mb-2"><i class="fa-regular fa-bell me-1"></i>Job alerts</h2>
                    <p class="small mb-3">Get an email when GREL publishes a vacancy that matches what you are looking for. You can switch it off at any time.</p>
                    <form asp-action="JobAlerts" method="post">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" name="active" value="true" id="alertActive" checked="@alert.IsActive" />
                            <label class="form-check-label" for="alertActive">Email me new vacancies</label>
                        </div>
                        <label for="alertKeywords" class="form-label small">Only vacancies mentioning <span class="text-body-secondary">(optional)</span></label>
                        <input id="alertKeywords" name="keywords" value="@alert.Keywords" class="form-control form-control-sm mb-1" maxlength="@JobAlertService.MaxKeywordsLength"
                               placeholder="e.g. engineer, accounting, driver" />
                        <div class="form-text mb-2">Separate words with commas. Leave empty for every vacancy.</div>
                        <button type="submit" class="btn btn-sm btn-outline-primary">Save job alert</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
