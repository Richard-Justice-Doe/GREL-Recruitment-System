@* The new employee's appointment letter: printable, with a signature box until it is signed. *@
@model MyAppointmentDto
@{
    ViewData["Title"] = $"Appointment letter {Model.LetterNumber}";
}

<div class="page-header d-print-none">
    <div>
        <h1>Your appointment letter</h1>
        <p>@Model.LetterNumber · <strong>@(Model.LetterSignedAt is null ? "Waiting for your signature" : "Signed")</strong></p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" data-print><i class="fa-solid fa-print me-1"></i>Print</button>
        <a asp-action="Details" asp-route-id="@ViewBag.ApplicationId" class="btn btn-outline-secondary">Back to my application</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <partial name="_AppointmentLetter" model="Model" />
    </div>

    <div class="col-xl-4 d-print-none">
        @if (Model.CanSign)
        {
            <div class="card glass border border-primary mb-3">
                <div class="card-body p-4">
                    <h2 class="h6 text-uppercase text-body-secondary mb-3">Sign the letter</h2>
                    <form asp-action="SignLetter" asp-route-id="@ViewBag.ApplicationId" method="post">
                        <label for="fullName" class="form-label small">Type your full name exactly as it appears on the letter: <strong>@Model.EmployeeName</strong></label>
                        <input id="fullName" name="fullName" class="form-control mb-2" maxlength="200" required autocomplete="name" />
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="confirm" value="true" id="confirm" required />
                            <label class="form-check-label small" for="confirm">I have read this letter and accept the appointment on these terms. Typing my name is my signature.</label>
                        </div>
                        <button type="submit" class="btn btn-success w-100"><i class="fa-solid fa-file-signature me-1"></i>Sign the letter</button>
                    </form>
                    <p class="small text-body-secondary mt-3 mb-0">Something wrong in the letter? Contact HR before signing; they can send a corrected letter.</p>
                </div>
            </div>
        }
        else if (Model.LetterSignedAt is not null)
        {
            <div class="alert alert-success">You signed this letter on @Model.LetterSignedAt.Value.ToString("d MMMM yyyy"). Welcome to GREL!</div>
        }
    </div>
</div>
