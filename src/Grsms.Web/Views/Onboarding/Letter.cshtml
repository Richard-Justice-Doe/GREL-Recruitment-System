@* Staff preview of the appointment letter, exactly as the new employee sees it. Printable. *@
@model MyAppointmentDto
@{
    ViewData["Title"] = $"Appointment letter: {Model.EmployeeName}";
}

<div class="page-header d-print-none">
    <div>
        <h1>Appointment letter</h1>
        <p>@(Model.LetterNumber ?? "Draft: not issued yet") · @Model.EmployeeName</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" data-print><i class="fa-solid fa-print me-1"></i>Print</button>
        <a asp-action="Details" asp-route-id="@ViewBag.OnboardingId" class="btn btn-outline-secondary">Back to the onboarding</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <partial name="_AppointmentLetter" model="Model" />
    </div>
</div>
