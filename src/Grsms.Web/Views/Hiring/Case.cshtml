@* The hiring case of one applicant: results so far, background checks, the hiring recommendation and its
   approvals (HOD → HR Manager → MD), and the offer. Each panel only shows the actions the user may take now. *@
@model HiringCaseDto
@{
    ViewData["Title"] = $"Hiring: {Model.ApplicantName}";
    var r = Model.Recommendation;
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    string CheckCss(CheckStatus s) => s switch
    {
        CheckStatus.Cleared => "badge-soft-success",
        CheckStatus.Concerns => "badge-soft-warning",
        CheckStatus.Failed => "badge-soft-danger",
        _ => "badge-soft-secondary"
    };
    string DecisionText(HiringDecision d, string endorse) => d switch
    {
        HiringDecision.Approve => endorse,
        HiringDecision.Reject => "Not supported",
        _ => "Waiting"
    };
}

<div class="page-header">
    <div>
        <h1>Hiring: @Model.ApplicantName <partial name="_ApplicationStatus" model="Model.ApplicationStatus" /></h1>
        <p><a asp-controller="Applications" asp-action="Details" asp-route-id="@Model.ApplicationId">@Model.ApplicationNumber</a>
            · @Model.VacancyNumber @Model.JobTitle · @Model.DivisionName → @Model.DepartmentName
            · positions: @Model.PositionsTaken of @Model.Positions offered or filled</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Interviews" asp-action="Results" asp-route-id="@Model.VacancyId" class="btn btn-outline-secondary">Interview results</a>
        <a asp-action="Index" class="btn btn-outline-secondary">All hiring</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-7">
        @* ---- Results so far *@
        <div class="card glass mb-3">
            <div class="card-body p-4 d-flex flex-wrap gap-4">
                <div><div class="small text-body-secondary">Screening score</div><div class="fs-4 fw-semibold">@(Model.ScreeningScore?.ToString() ?? "—")</div></div>
                <div><div class="small text-body-secondary">Interview average</div><div class="fs-4 fw-semibold">@(Model.InterviewAverage?.ToString("0.0") ?? "—")</div></div>
                <div><div class="small text-body-secondary">Completed sessions</div><div class="fs-4 fw-semibold">@Model.CompletedInterviews</div></div>
                <div><div class="small text-body-secondary">Advertised salary</div><div class="fs-6 fw-semibold">
                    @(Model.VacancySalaryMin is null && Model.VacancySalaryMax is null ? "Not set" : $"GHS {Model.VacancySalaryMin:N0} – {Model.VacancySalaryMax:N0}")</div></div>
            </div>
        </div>

        @* ---- Hiring recommendation *@
        <div class="card glass mb-3">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">Hiring recommendation @(r is null ? "" : $"{r.Number}")</h2>
                @if (r is null)
                {
                    @if (Model.CanRecommend)
                    {
                        <form asp-action="Recommend" asp-route-id="@Model.ApplicationId" method="post">
                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label for="salary" class="form-label small">Proposed monthly salary (GHS)</label>
                                    <input id="salary" name="salary" type="number" step="0.01" min="1" class="form-control" required value="@Model.VacancySalaryMin" />
                                </div>
                                <div class="col-md-6">
                                    <label for="startDate" class="form-label small">Proposed start date</label>
                                    <input id="startDate" name="startDate" type="date" class="form-control" required min="@today.ToString("yyyy-MM-dd")" value="@today.AddDays(30).ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                            <label for="justification" class="form-label small">Why this candidate (interview results, references, fit)</label>
                            <textarea id="justification" name="justification" class="form-control mb-2" rows="4" maxlength="4000" required></textarea>
                            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-paper-plane me-1"></i>Recommend and ask the HOD to endorse</button>
                        </form>
                    }
                    else
                    {
                        <p class="small text-body-secondary mb-0">@(Model.RecommendBlockedReason ?? "No recommendation yet.")</p>
                    }
                }
                else
                {
                    <p class="mb-2"><span class="badge rounded-pill @(r.Status == HiringStatus.Approved ? "badge-soft-success" : r.Status == HiringStatus.Rejected ? "badge-soft-danger" : "badge-soft-warning")">@r.Status.DisplayName()</span></p>
                    <dl class="details-grid small">
                        <dt>Proposed by</dt><dd>@r.CreatedBy, @r.CreatedAt.ToString("dd MMM yyyy")</dd>
                        <dt>Salary</dt><dd>GHS @r.ProposedSalary.ToString("N2") per month</dd>
                        <dt>Start date</dt><dd>@r.ProposedStartDate.ToString("dd MMM yyyy")</dd>
                        <dt>Justification</dt><dd style="white-space: pre-wrap">@r.Justification</dd>
                    </dl>
                    <ol class="list-unstyled small mb-0">
                        <li class="py-1"><strong>1. Head of Department:</strong> @DecisionText(r.HodDecision, "Endorsed")@(r.HodName is null ? "" : $" by {r.HodName}")@(r.HodComment is null ? "" : $": {r.HodComment}")</li>
                        <li class="py-1"><strong>2. HR Manager:</strong> @DecisionText(r.HrDecision, "Approved")@(r.HrName is null ? "" : $" by {r.HrName}")@(r.HrComment is null ? "" : $": {r.HrComment}")</li>
                        <li class="py-1"><strong>3. Managing Director:</strong> @DecisionText(r.MdDecision, "Approved")@(r.MdName is null ? "" : $" by {r.MdName}")@(r.MdComment is null ? "" : $": {r.MdComment}")</li>
                    </ol>

                    @if (Model.CanHodDecide || Model.CanHrDecide || Model.CanMdDecide)
                    {
                        <form asp-action="Decide" asp-route-id="@Model.ApplicationId" method="post" class="border border-primary rounded-3 p-3 mt-3">
                            <h3 class="h6">@(Model.CanHodDecide ? "Your endorsement as Head of Department" : Model.CanHrDecide ? "Your decision as HR Manager" : "Your final decision as Managing Director")</h3>
                            @if (Model.CanHrDecide && Model.HrNeedsOverride)
                            {
                                <div class="alert alert-warning small py-2">The Head of Department did <strong>not</strong> endorse this hire. To approve anyway, record your reason.</div>
                            }
                            <textarea name="comment" class="form-control form-control-sm mb-2" rows="2" maxlength="4000"
                                      placeholder="Comment (required to reject@(Model.CanHrDecide && Model.HrNeedsOverride ? " or to override the HOD" : ""))"></textarea>
                            <div class="d-flex gap-2">
                                <button type="submit" name="decision" value="Approve" class="btn btn-sm btn-success">@(Model.CanHodDecide ? "Endorse" : "Approve")</button>
                                <button type="submit" name="decision" value="Reject" class="btn btn-sm btn-outline-danger">@(Model.CanHodDecide ? "Do not endorse" : "Reject")</button>
                            </div>
                        </form>
                    }
                    @if (Model.CanWithdrawRecommendation)
                    {
                        <form asp-action="WithdrawRecommendation" asp-route-id="@Model.ApplicationId" method="post" class="mt-3">
                            <div class="input-group input-group-sm">
                                <input name="reason" class="form-control" placeholder="Reason for withdrawing" maxlength="2000" required aria-label="Reason for withdrawing" />
                                <button type="submit" class="btn btn-outline-secondary" data-confirm="Withdraw this recommendation?">Withdraw</button>
                            </div>
                        </form>
                    }
                }
                @foreach (var p in Model.PastRecommendations)
                {
                    <div class="small text-body-secondary mt-2">Earlier: @p.Number, @p.Status.DisplayName().ToLowerInvariant() (@p.CreatedAt.ToString("dd MMM yyyy"))</div>
                }
            </div>
        </div>

        @* ---- Offer *@
        <div class="card glass mb-3">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">Offer</h2>
                @if (Model.Offer is { } o)
                {
                    <dl class="details-grid small">
                        <dt>Offer</dt><dd>@o.Number · <strong>@o.Status.DisplayName()</strong></dd>
                        <dt>Salary</dt><dd>GHS @o.MonthlySalary.ToString("N2") per month</dd>
                        <dt>Start date</dt><dd>@o.StartDate.ToString("dd MMM yyyy")</dd>
                        <dt>Reply by</dt><dd>@o.ExpiresOn.ToString("dd MMM yyyy")</dd>
                        <dt>Sent</dt><dd>@o.SentAt.ToString("dd MMM yyyy HH:mm")</dd>
                        @if (o.RespondedAt is not null) { <dt>Answered</dt><dd>@o.RespondedAt.Value.ToString("dd MMM yyyy HH:mm")</dd> }
                    </dl>
                    @* Phase 9: onboarding follows an accepted offer. *@
                    @if (ViewBag.OnboardingId is int onboardingId)
                    {
                        <a asp-controller="Onboarding" asp-action="Details" asp-route-id="@onboardingId" class="btn btn-sm btn-outline-primary mb-2"><i class="fa-solid fa-door-open me-1"></i>Open the onboarding</a>
                    }
                    else if (o.Status == OfferStatus.Accepted && (User.IsInRole(Roles.RecruitmentOfficer) || User.IsInRole(Roles.HrManager)))
                    {
                        <a asp-controller="Onboarding" asp-action="Start" asp-route-id="@Model.ApplicationId" class="btn btn-sm btn-primary mb-2"><i class="fa-solid fa-play me-1"></i>Start onboarding</a>
                    }
                    @if (Model.CanWithdrawOffer)
                    {
                        <form asp-action="WithdrawOffer" asp-route-id="@Model.ApplicationId" method="post">
                            <div class="input-group input-group-sm">
                                <input name="reason" class="form-control" placeholder="Reason for withdrawing the offer" maxlength="2000" required aria-label="Reason" />
                                <button type="submit" class="btn btn-outline-danger" data-confirm="Withdraw the offer? The candidate will be told.">Withdraw offer</button>
                            </div>
                        </form>
                    }
                }
                else if (Model.CanOffer)
                {
                    <form asp-action="SendOffer" asp-route-id="@Model.ApplicationId" method="post">
                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <label for="offerSalary" class="form-label small">Monthly salary (GHS)</label>
                                <input id="offerSalary" name="salary" type="number" step="0.01" class="form-control" value="@r!.ProposedSalary" max="@r.ProposedSalary" required />
                            </div>
                            <div class="col-md-4">
                                <label for="offerStart" class="form-label small">Start date</label>
                                <input id="offerStart" name="startDate" type="date" class="form-control" value="@r.ProposedStartDate.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-md-4">
                                <label for="expiresOn" class="form-label small">Reply by</label>
                                <input id="expiresOn" name="expiresOn" type="date" class="form-control" value="@today.AddDays(7).ToString("yyyy-MM-dd")" required />
                            </div>
                        </div>
                        <label for="terms" class="form-label small">Other terms for the letter (probation, benefits, ...)</label>
                        <textarea id="terms" name="terms" class="form-control mb-2" rows="4" maxlength="8000">Probation: 6 months.
Benefits: in line with GREL's conditions of service for this grade.</textarea>
                        <button type="submit" class="btn btn-primary" data-confirm="Send the offer to the candidate?"><i class="fa-solid fa-envelope-open-text me-1"></i>Send offer</button>
                    </form>
                }
                else
                {
                    <p class="small text-body-secondary mb-0">@(Model.OfferBlockedReason ?? "An offer can be sent once the hiring recommendation is approved by the Managing Director.")</p>
                }
                @foreach (var p in Model.PastOffers)
                {
                    <div class="small text-body-secondary mt-2">Earlier: @p.Number, @p.Status.DisplayName().ToLowerInvariant()@(p.Reason is null ? "" : $" ({p.Reason})")</div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-5">
        @* ---- Background checks *@
        <div class="card glass mb-3">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">Background checks</h2>
                @if (Model.Checks.Count == 0)
                {
                    <p class="small text-body-secondary">None yet. At least one completed check (e.g. references) is needed before an offer.</p>
                }
                @foreach (var c in Model.Checks)
                {
                    <div class="border rounded-3 p-2 mb-2 small">
                        <div class="d-flex justify-content-between gap-2">
                            <strong>@c.Type.DisplayName()</strong>
                            <span class="badge rounded-pill @CheckCss(c.Status)">@c.Status.DisplayName()</span>
                        </div>
                        <div class="text-body-secondary">@c.Subject</div>
                        @if (c.Notes is not null) { <div class="mt-1">@c.Notes</div> }
                        @if (Model.CanRecordChecks && c.Status == CheckStatus.Pending)
                        {
                            <form asp-action="CompleteCheck" asp-route-id="@Model.ApplicationId" method="post" class="mt-2">
                                <input type="hidden" name="checkId" value="@c.Id" />
                                <textarea name="notes" class="form-control form-control-sm mb-1" rows="2" maxlength="4000" placeholder="Notes (required for concerns or failure)"></textarea>
                                <div class="d-flex flex-wrap gap-1">
                                    <button type="submit" name="status" value="Cleared" class="btn btn-sm btn-outline-success">Cleared</button>
                                    <button type="submit" name="status" value="Concerns" class="btn btn-sm btn-outline-warning">Cleared with concerns</button>
                                    <button type="submit" name="status" value="Failed" class="btn btn-sm btn-outline-danger">Failed</button>
                                </div>
                            </form>
                        }
                    </div>
                }
                @if (Model.CanRecordChecks)
                {
                    <form asp-action="AddCheck" asp-route-id="@Model.ApplicationId" method="post" class="mt-3">
                        <div class="input-group input-group-sm mb-1">
                            <select name="type" class="form-select" aria-label="Type of check">
                                @foreach (var t in Enum.GetValues<CheckType>())
                                {
                                    <option value="@t">@t.DisplayName()</option>
                                }
                            </select>
                        </div>
                        <div class="input-group input-group-sm">
                            <input name="subject" class="form-control" maxlength="300" required placeholder="Who or what (e.g. referee's name and company)" aria-label="Who or what is checked" />
                            <button type="submit" class="btn btn-outline-primary">Add check</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
