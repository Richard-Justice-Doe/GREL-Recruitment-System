@* Staff home page (dashboard). Data comes from DashboardService (Application/Dashboard).
   Layout (redesign, November 2026): green welcome banner, "Your to-dos" cards, workforce panel, action cards (docs/32; they
   replaced the KPI cards with 7-day bar charts), then requests in progress + latest candidates on the left and the vacancy closing calendar on the
   right. Panels the user may not see are left out. *@
@using System.Globalization
@using Grsms.Application.Dashboard
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Auth
@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    var d = Model.Dashboard;
    var name = User.FindFirst(AppClaimsPrincipalFactory.FullNameClaim)?.Value ?? "";
    var firstName = name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? name;
    var canUsers = (await Auth.AuthorizeAsync(User, Policies.UserAdmin)).Succeeded;
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var hour = DateTime.UtcNow.Hour; // GREL is on GMT
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";

    var showCalendar = d.ClosingDays is not null;
    var showBottom = d.InProgress is not null || d.LatestCandidates is not null;

    // Tasks come oldest first, so the first one is the one to start with.
    var overdueCount = d.Tasks.Count(t => (DateTime.UtcNow - t.Since).TotalDays >= 3);
    var firstTaskUrl = d.Tasks.Count > 0 ? TaskUrl(d.Tasks[0]) : null;
}
@functions {
    // Same initials + colour for the same person everywhere on the page.
    private static readonly string[] AvatarColours = ["#1f6b4a", "#2f6fdf", "#7c4dce", "#d9822b", "#c2410c", "#0f8a8a", "#b8336a"];

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    private static string AvatarColour(string name)
    {
        var h = 0;
        foreach (var c in name) h = unchecked(h * 31 + c);
        return AvatarColours[(h & 0x7fffffff) % AvatarColours.Length];
    }


    // The page a task opens.
    private string? TaskUrl(DashboardTaskDto t) => t.Target switch
    {
        DashboardTaskTarget.Request => Url.Action("Details", "RecruitmentRequests", new { id = t.Id }),
        DashboardTaskTarget.Vacancy => Url.Action("Details", "Vacancies", new { id = t.Id }),
        DashboardTaskTarget.Shortlist => Url.Action("Vacancy", "Shortlisting", new { id = t.Id }),
        DashboardTaskTarget.Interview or DashboardTaskTarget.InterviewValidation => Url.Action("Details", "Interviews", new { id = t.Id }),
        DashboardTaskTarget.Hiring or DashboardTaskTarget.HiringRecommendation => Url.Action("Case", "Hiring", new { id = t.Id }),
        DashboardTaskTarget.Onboarding => Url.Action("Details", "Onboarding", new { id = t.Id }),
        DashboardTaskTarget.NewOnboarding => Url.Action("Start", "Onboarding", new { id = t.Id }),
        DashboardTaskTarget.AtsConfirm => Url.Action("Vacancy", "Ats", new { id = t.Id }),
        DashboardTaskTarget.OnboardingLetter or DashboardTaskTarget.OnboardingDocuments or DashboardTaskTarget.OnboardingActivate
            or DashboardTaskTarget.OnboardingInduction => Url.Action("Details", "Onboarding", new { id = t.Id }),
        DashboardTaskTarget.ProbationStep or DashboardTaskTarget.ProbationDecision => Url.Action("Details", "Probation", new { id = t.Id }),
        DashboardTaskTarget.Advert => Url.Action("Details", "Adverts", new { id = t.Id }),
        _ => Url.Action("Create", "Vacancies", new { requestId = t.Id })
    };

    // Stage colour, label and button text of a to-do card (site.css section 10).
    private static (string Tone, string Label, string Button) TaskLook(DashboardTaskTarget target) => target switch
    {
        DashboardTaskTarget.Request => ("tone-hire", "Recruitment request", "Open request"),
        DashboardTaskTarget.Vacancy => ("tone-hire", "Vacancy", "Open vacancy"),
        DashboardTaskTarget.NewVacancyForRequest => ("tone-hire", "Vacancy", "Create the vacancy"),
        DashboardTaskTarget.Shortlist => ("tone-hire", "Shortlist", "Open shortlist"),
        DashboardTaskTarget.Interview => ("tone-interview", "Interview", "Open scorecard"),
        DashboardTaskTarget.InterviewValidation => ("tone-interview", "Score validation", "Check the scores"),
        DashboardTaskTarget.Hiring => ("tone-offer", "Hiring decision", "Open hiring case"),
        DashboardTaskTarget.HiringRecommendation => ("tone-offer", "Ready for hiring", "Decide"),
        DashboardTaskTarget.NewOnboarding => ("tone-onboard", "Onboarding", "Start onboarding"),
        DashboardTaskTarget.AtsConfirm => ("tone-hire", "Screening", "Confirm or overrule"),
        DashboardTaskTarget.OnboardingLetter => ("tone-onboard", "Appointment letter", "Issue the letter"),
        DashboardTaskTarget.OnboardingDocuments => ("tone-onboard", "Documents", "Verify the documents"),
        DashboardTaskTarget.OnboardingActivate => ("tone-onboard", "Ready for activation", "Activate"),
        DashboardTaskTarget.OnboardingInduction => ("tone-onboard", "Induction", "Close the onboarding"),
        DashboardTaskTarget.ProbationStep => ("tone-probation", "Probation", "Open the probation"),
        DashboardTaskTarget.ProbationDecision => ("tone-probation", "Probation decision", "Decide"),
        DashboardTaskTarget.Advert => ("tone-hire", "Job advert", "Open advert"),
        _ => ("tone-onboard", "Onboarding", "Open checklist")
    };
}

@* ---------------------------------------------------------------- Welcome banner (redesign, November 2026) *@
<section class="hero">
    <div class="hero-text">
        <span class="hero-date">@today.ToString("dddd d MMMM yyyy", CultureInfo.GetCultureInfo("en-GB"))</span>
        <h1>@greeting, @firstName</h1>
        <p>
            @if (d.TaskTotal == 0)
            {
                <text>You're all caught up. Nothing is waiting for you.</text>
            }
            else
            {
                <text>You have <strong>@d.TaskTotal @(d.TaskTotal == 1 ? "thing" : "things") to do</strong>.</text>
                @if (overdueCount > 0)
                {
                    <text> @overdueCount @(overdueCount == 1 ? "has" : "have") been waiting 3 days or more.</text>
                }
            }
        </p>
    </div>
    @if (firstTaskUrl is not null)
    {
        <a href="@firstTaskUrl" class="hero-cta">Start with the first one <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    }
    @if (Model.DivisionList is not null)
    {
        @* Division / Department filter for the activity cards, the in-progress list and the calendar. *@
        <form method="get" class="dash-filter" aria-label="Filter the dashboard">
            @if (d.Month != new DateOnly(today.Year, today.Month, 1))
            {
                <input type="hidden" name="month" value="@d.Month.ToString("yyyy-MM")" />
            }
            <select name="divisionId" asp-items="Model.DivisionList" class="form-select form-select-sm" aria-label="Division" data-auto-submit>
                <option value="">All divisions</option>
            </select>
            <select name="departmentId" asp-items="Model.DepartmentList" class="form-select form-select-sm" aria-label="Department" data-auto-submit>
                <option value="">All departments</option>
            </select>
            <noscript><button type="submit" class="btn btn-sm btn-primary">Apply</button></noscript>
            @if (Model.Filter.IsSet)
            {
                <a asp-action="Index" class="btn btn-sm btn-link px-1">Clear</a>
            }
        </form>
    }
</section>
@if (Model.Filter.IsSet)
{
    <p class="small text-body-secondary mb-2">
        <i class="fa-solid fa-filter me-1"></i>Filtered. <i>Your to-dos</i> still lists everything waiting for you, and
        <i>Registered candidates</i> counts all candidates (candidates are linked to a department once they apply, in a later phase).
    </p>
}

@* ---------------------------------------------------------------- Your to-dos: one card per thing waiting for you *@
<section aria-labelledby="todos-title">
    <div class="section-head">
        <h2 id="todos-title">Your to-dos</h2>
        <span class="section-sub">Only things waiting for you, oldest first</span>
    </div>
    @if (d.Tasks.Count == 0)
    {
        <div class="todo-empty">
            <i class="fa-regular fa-circle-check" aria-hidden="true"></i>
            <span>You're all caught up. Nothing is waiting for you.</span>
        </div>
    }
    else
    {
        <div class="todo-grid">
            @foreach (var t in d.Tasks)
            {
                var look = TaskLook(t.Target);
                var person = t.PersonName == "You" ? name : t.PersonName;
                var days = (int)(DateTime.UtcNow - t.Since).TotalDays;
                <article class="todo-card @look.Tone">
                    <div class="todo-card-top">
                        <span class="pill">@look.Label</span>
                        @if (days >= 3)
                        {
                            <span class="pill pill-danger" title="Waiting since @t.Since.ToString("ddd d MMM")"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>Waiting @days days</span>
                        }
                        else if (t.Since > DateTime.UtcNow)
                        {
                            <span class="pill pill-muted">@t.Since.ToString("ddd d MMM, HH:mm")</span>
                        }
                        else
                        {
                            <span class="pill pill-muted">Since @t.Since.ToString("ddd d MMM")</span>
                        }
                    </div>
                    <h3>@t.Title</h3>
                    <p class="todo-meta">@t.Reference · @t.Action</p>
                    @if (t.PersonName != "Recruitment")
                    {
                        <span class="todo-from">
                            <span class="mini-avatar" style="background:@AvatarColour(person)" aria-hidden="true">@Initials(person)</span>
                            @(t.PersonName == "You" ? "Your own" : $"From {t.PersonName}")
                        </span>
                    }
                    <a href="@TaskUrl(t)" class="btn">@look.Button <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                </article>
            }
        </div>
        @if (d.TaskTotal > d.Tasks.Count)
        {
            <p class="dash-more mt-n3 mb-4">Showing the @d.Tasks.Count oldest of @d.TaskTotal. Open Recruitment requests or Vacancies to see them all.</p>
        }
    }
</section>

@* ---------------------------------------------------------------- Phase 21: onboarding and probation widgets *@
@if (!Model.Workforce.IsEmpty)
{
    <partial name="_WorkforcePanel" model="Model.Workforce" />
}

@* ---------------------------------------------------------------- IT Manager: job adverts (11 Nov 2026, docs/29 change 2) *@
@if (d.AdvertCards is { } ac)
{
    <h2 class="h6 text-uppercase text-body-secondary mb-2">Job adverts</h2>
    <div class="kpi-grid mb-3">
        @foreach (var (title, icon, count, tab, tone) in new[]
                 {
                     ("Awaiting your approval", "fa-hourglass-half", ac.AwaitingApproval, "it", "tone-offer"),
                     ("Scheduled", "fa-clock", ac.Scheduled, "scheduled", "tone-probation"),
                     ("Active (published)", "fa-tower-broadcast", ac.Active, "live", "tone-onboard"),
                     ("Expired or closed", "fa-box-archive", ac.Expired, "closed", "tone-hire"),
                 })
        {
            <section class="dash-card kpi-card @tone">
                <header class="kpi-head">
                    <i class="fa-solid @icon"></i>
                    <a href="@Url.Action("Index", "Adverts", new { tab })" class="stretched-link text-reset text-decoration-none">@title</a>
                    <i class="fa-solid fa-chevron-right kpi-go"></i>
                </header>
                <div class="kpi-figure"><span class="kpi-value">@count.ToString("N0")</span></div>
            </section>
        }
    </div>
}

@* ---------------------------------------------------------------- Action cards (docs/32, 11 November 2026)
   What needs attention, each opening the list that shows it. They replace the KPI row with 7-day charts; the work waiting
   for you is listed one by one under "Your to-dos", and onboarding and probation are in the workforce panel. *@
@if (d.Cards.Count > 0)
{
    <div class="kpi-grid mb-3">
        @foreach (var c in d.Cards)
        {
            var waiting = c.Attention && c.Count > 0;
            <section class="dash-card kpi-card action-card @c.Tone @(waiting ? "is-waiting" : "")">
                <header class="kpi-head">
                    <i class="fa-solid @c.Icon"></i>
                    <a href="@Url.Action(c.Action, c.Controller, c.Route.ToDictionary(x => x.Key, x => (object?)x.Value))" class="stretched-link text-reset text-decoration-none" data-fresh>@c.Title</a>
                    <i class="fa-solid fa-chevron-right kpi-go"></i>
                </header>
                <div class="kpi-figure mb-0">
                    <span class="kpi-value">@c.Count.ToString("N0")</span>
                    @if (waiting)
                    {
                        <span class="badge rounded-pill text-bg-danger">Action needed</span>
                    }
                </div>
                <span class="kpi-note">@c.Hint</span>
            </section>
        }
    </div>
}

<div class="row g-3">
    <div class="@(showCalendar ? "col-xl-8" : "col-12")">

        @if (showBottom)
        {
            <div class="row g-3">
                @* ---------------------------------------------------------------- Requests in progress *@
                @if (d.InProgress is not null)
                {
                    <div class="@(d.LatestCandidates is not null ? "col-lg-6" : "col-12")">
                        <section class="dash-card h-100">
                            <header class="dash-card-head">
                                <h2><i class="fa-solid fa-bars-progress"></i> Requests in approval</h2>
                                <a asp-controller="RecruitmentRequests" asp-action="Index" asp-route-tab="all" class="view-more">View more <i class="fa-solid fa-chevron-right"></i></a>
                            </header>
                            @if (d.InProgress.Count == 0)
                            {
                                <div class="dash-empty"><i class="fa-regular fa-folder-open"></i><div>No requests are waiting for approval.</div></div>
                            }
                            else
                            {
                                <table class="table dash-table">
                                    <thead><tr><th>Position</th><th style="width:42%">Progress</th></tr></thead>
                                    <tbody>
                                        @foreach (var r in d.InProgress)
                                        {
                                            <tr>
                                                <td>
                                                    <a asp-controller="RecruitmentRequests" asp-action="Details" asp-route-id="@r.Id" class="person text-reset text-decoration-none">
                                                        <span class="mini-avatar" style="background:@AvatarColour(r.RequestedByName)" title="Raised by @r.RequestedByName">@Initials(r.RequestedByName)</span>
                                                        <span class="text-truncate">@r.PositionTitle</span>
                                                    </a>
                                                </td>
                                                <td>
                                                    <div class="progress-line" title="@r.Status.DisplayName()">
                                                        <div class="progress" role="progressbar" aria-label="@r.PositionTitle progress" aria-valuenow="@r.Percent" aria-valuemin="0" aria-valuemax="100">
                                                            <div class="progress-bar" style="width:@r.Percent%"></div>
                                                        </div>
                                                        <span>@r.Percent%</span>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                @if (d.InProgressTotal > d.InProgress.Count)
                                {
                                    <div class="dash-more">+ @(d.InProgressTotal - d.InProgress.Count) more in approval</div>
                                }
                            }
                        </section>
                    </div>
                }

                @* ---------------------------------------------------------------- Latest candidates *@
                @if (d.LatestCandidates is not null)
                {
                    <div class="@(d.InProgress is not null ? "col-lg-6" : "col-12")">
                        <section class="dash-card h-100">
                            <header class="dash-card-head">
                                <h2><i class="fa-solid fa-id-badge"></i> Latest candidates</h2>
                                @if (canUsers)
                                {
                                    <a asp-controller="Users" asp-action="Index" asp-route-candidates="true" class="view-more">View more <i class="fa-solid fa-chevron-right"></i></a>
                                }
                            </header>
                            @if (d.LatestCandidates.Count == 0)
                            {
                                <div class="dash-empty"><i class="fa-regular fa-user"></i><div>No candidates have registered yet.</div></div>
                            }
                            else
                            {
                                <table class="table dash-table">
                                    <thead><tr><th>Name</th><th>Registered</th></tr></thead>
                                    <tbody>
                                        @foreach (var c in d.LatestCandidates)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="person" title="@c.Email">
                                                        <span class="mini-avatar" style="background:@AvatarColour(c.FullName)">@Initials(c.FullName)</span>
                                                        <span class="text-truncate">@c.FullName</span>
                                                    </span>
                                                </td>
                                                <td class="text-nowrap">
                                                    @c.RegisteredAt.ToString("d MMM yyyy")
                                                    @if (!c.EmailConfirmed)
                                                    {
                                                        <span class="badge rounded-pill badge-soft-warning ms-1" title="Email address not confirmed yet">Unconfirmed</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </section>
                    </div>
                }
            </div>
        }
    </div>

    @* ---------------------------------------------------------------- Vacancy closing calendar *@
    @if (showCalendar)
    {
        var prev = d.Month.AddMonths(-1);
        var next = d.Month.AddMonths(1);
        <div class="col-xl-4">
            <section class="dash-card calendar-card">
                <header class="dash-card-head">
                    <h2><i class="fa-regular fa-calendar"></i> Vacancy closing dates</h2>
                    <a asp-controller="Vacancies" asp-action="Index" asp-route-tab="open" class="view-more">View more <i class="fa-solid fa-chevron-right"></i></a>
                </header>
                <nav class="month-nav" aria-label="Choose month">
                    <a asp-action="Index" asp-route-month="@prev.ToString("yyyy-MM")" asp-route-divisionId="@Model.Filter.DivisionId" asp-route-departmentId="@Model.Filter.DepartmentId" aria-label="Previous month">
                        <i class="fa-solid fa-chevron-left"></i><span>@prev.ToString("MMMM")</span>
                    </a>
                    <strong>@d.Month.ToString("MMMM yyyy")</strong>
                    <a asp-action="Index" asp-route-month="@next.ToString("yyyy-MM")" asp-route-divisionId="@Model.Filter.DivisionId" asp-route-departmentId="@Model.Filter.DepartmentId" aria-label="Next month">
                        <span>@next.ToString("MMMM")</span><i class="fa-solid fa-chevron-right"></i>
                    </a>
                </nav>

                @if (d.ClosingDays!.Count == 0)
                {
                    <div class="dash-empty">
                        <i class="fa-regular fa-calendar-xmark"></i>
                        <div>No vacancies close in @d.Month.ToString("MMMM yyyy").</div>
                    </div>
                }
                else
                {
                    <div class="closing-list">
                        @foreach (var day in d.ClosingDays)
                        {
                            var daysLeft = day.Date.DayNumber - today.DayNumber;
                            <div class="closing-day @(daysLeft < 0 ? "past" : "")">
                                <div class="cal-chip @(day.Date == today ? "today" : "")">
                                    <span>@day.Date.ToString("ddd")</span>
                                    <strong>@day.Date.Day</strong>
                                </div>
                                <div class="closing-items">
                                    @foreach (var v in day.Vacancies)
                                    {
                                        var tone = v.IsClosed || daysLeft < 0 ? "muted" : daysLeft <= 3 ? "danger" : daysLeft <= 7 ? "warning" : "success";
                                        <a asp-controller="Vacancies" asp-action="Details" asp-route-id="@v.Id" class="closing-item tone-@tone">
                                            <span class="closing-title">@v.JobTitle</span>
                                            <small>
                                                <i class="fa-solid fa-building"></i> @v.DepartmentName
                                                · @v.Positions @(v.Positions == 1 ? "position" : "positions")
                                                @if (v.IsClosed)
                                                {
                                                    <text>· closed</text>
                                                }
                                                else if (daysLeft == 0)
                                                {
                                                    <text>· closes today</text>
                                                }
                                                else if (daysLeft > 0)
                                                {
                                                    <text>· @daysLeft @(daysLeft == 1 ? "day" : "days") left</text>
                                                }
                                            </small>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    }
</div>
