@* Phase 16: edit one email template, with a live preview (example values) after "Preview" or a failed save. *@
@using Grsms.Application.Settings
@using Grsms.Domain.Settings
@model EmailTemplateFormDto
@{
    var d = Model.Definition!;
    ViewData["Title"] = $"Email: {d.Name}";
    var canManage = ViewBag.CanManage == true;
}

<div class="page-header">
    <div>
        <h1>@d.Name</h1>
        <p>@d.WhenSent. @(Model.IsCustomised ? "Customised wording." : "Built-in wording.")</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to the templates</a>
</div>

<div class="row g-3">
    <div class="col-xl-6">
        <form asp-action="Edit" asp-route-id="@Model.Key" method="post" class="card glass" novalidate>
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <fieldset disabled="@(!canManage)">
                    <div class="mb-3">
                        <label class="form-label" for="Subject">Subject</label>
                        <input id="Subject" name="Subject" class="form-control" maxlength="200" value="@Model.Subject" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Body">Message</label>
                        <textarea id="Body" name="Body" class="form-control font-monospace" rows="12" maxlength="4000">@Model.Body</textarea>
                        <div class="form-text">Plain text: a blank line starts a new paragraph. HTML is shown as typed, never run.</div>
                    </div>
                </fieldset>
                <div class="small mb-3">
                    <strong>Placeholders you can use:</strong>
                    @foreach (var p in EmailTemplateCatalogue.AllowedPlaceholders(d))
                    {
                        <code class="me-1">{{@p}}</code>
                    }
                    <div class="text-body-secondary">The greeting ("Dear ...,"), the "@d.LinkText" link and the signature are added to every email automatically.</div>
                </div>
                @if (canManage)
                {
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Save</button>
                        <button type="submit" name="preview" value="true" class="btn btn-outline-secondary"><i class="fa-regular fa-eye me-1"></i>Preview</button>
                    </div>
                }
                <details class="mt-3 small">
                    <summary>Built-in wording</summary>
                    <div class="mt-2"><strong>Subject:</strong> @d.DefaultSubject</div>
                    <div style="white-space: pre-wrap" class="mt-1">@d.DefaultBody</div>
                </details>
            </div>
        </form>
    </div>
    <div class="col-xl-6">
        <div class="card glass">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">Preview (example values)</h2>
                <div class="small text-body-secondary mb-1">Subject</div>
                <div class="fw-semibold mb-3">@Model.PreviewSubject</div>
                <div class="border rounded-3 p-3">
                    <p>Dear Ama Mensah,</p>
                    @* Safe: everything typed and every value was HTML-encoded by EmailTemplateCatalogue.RenderBody. *@
                    @Html.Raw(Model.PreviewHtml)
                    <p><a href="#" tabindex="-1">@d.LinkText</a></p>
                    <p class="text-body-secondary small mb-0">(signature from System settings)</p>
                </div>
            </div>
        </div>
    </div>
</div>
