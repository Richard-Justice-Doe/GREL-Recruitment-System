@* User accounts. Two tabs: GREL staff (managed here) and candidates (self-registered; can only be
   deactivated or unlocked here). *@
@model IReadOnlyList<UserListItemDto>
@{
    var showCandidates = ViewBag.ShowCandidates == true;
    ViewData["Title"] = "Users & roles";
    // Phase 14: accounts with a privileged role can only be changed by a Super Admin (the service checks again).
    var isSuperAdmin = User.IsInRole(Roles.SuperAdmin);
    var myRoles = new[] { Roles.SuperAdmin, Roles.Admin, Roles.HrAdministrator }.Where(User.IsInRole).ToList();
    var isAdmin = User.IsInRole(Roles.Admin);
}

<div class="page-header">
    <div>
        <h1>Users &amp; roles</h1>
        <p>Create staff accounts, assign roles, and deactivate or unlock accounts.
            @if (!isSuperAdmin)
            {
                <br /><span class="small">You can give the Employee and Interview Panel Member roles; other roles (HR Manager, Recruitment Officer, HOD, ...) are given by a Super Admin. @(isAdmin ? "As an Admin you can edit, reset and deactivate every account except Admins and Super Admins." : "Accounts with other roles are managed by an Admin or Super Admin.")</span>
            }
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="CreateCandidate" class="btn btn-outline-primary"><i class="fa-solid fa-user-plus me-1"></i>Add candidate account</a>
        <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-user-plus me-1"></i>Add staff account</a>
    </div>
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link @(showCandidates ? "" : "active")" asp-action="Index">GREL staff</a></li>
    <li class="nav-item"><a class="nav-link @(showCandidates ? "active" : "")" asp-action="Index" asp-route-candidates="true">Candidates</a></li>
</ul>

<div class="card glass">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    @if (!showCandidates)
                    {
                        <th>Staff no.</th>
                        <th>Department</th>
                        <th>Roles</th>
                    }
                    <th>Status</th>
                    <th>Last sign-in</th>
                    <th class="no-sort text-end">Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var u in Model)
                {
                    <tr class="@(u.IsActive ? "" : "row-inactive")">
                        <td class="fw-semibold">@u.FullName</td>
                        <td>@u.Email</td>
                        @if (!showCandidates)
                        {
                            <td>@u.StaffNumber</td>
                            <td>@u.DepartmentName</td>
                            <td>
                                @foreach (var r in u.Roles)
                                {
                                    <span class="badge rounded-pill badge-soft-primary me-1">@r</span>
                                }
                            </td>
                        }
                        <td>
                            <partial name="_ActiveBadge" model="u.IsActive" />
                            @if (u.IsLockedOut)
                            {
                                <span class="badge rounded-pill badge-soft-danger">Locked</span>
                            }
                        </td>
                        <td data-order="@(u.LastSignInAt?.ToString("o"))" class="small text-nowrap">@(u.LastSignInAt?.ToString("dd MMM yyyy HH:mm") ?? "Never")</td>
                        <td class="text-end text-nowrap">
                            @{ var canChange = Roles.CanManageAccount(myRoles, u.Roles); }
                            @if (!u.IsCandidate && canChange)
                            {
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                            }
                            else if (!u.IsCandidate)
                            {
                                <span class="badge rounded-pill badge-soft-secondary me-1" title="You cannot change this account"><i class="fa-solid fa-lock me-1"></i>@(u.Roles.Any(r => r is Roles.SuperAdmin or Roles.Admin) ? "Super Admin" : "Admin")</span>
                            }
                            @if (u.IsLockedOut)
                            {
                                <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                    <input type="hidden" name="candidates" value="@showCandidates" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Unlock"><i class="fa-solid fa-unlock"></i></button>
                                </form>
                            }
                            @if (canChange)
                            {
                                <form asp-action="SetActive" asp-route-id="@u.Id" method="post" class="d-inline">
                                    <input type="hidden" name="active" value="@(!u.IsActive)" />
                                    <input type="hidden" name="candidates" value="@showCandidates" />
                                    @if (u.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate" data-confirm="Deactivate @u.FullName? They will not be able to sign in."><i class="fa-solid fa-user-slash"></i></button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Activate"><i class="fa-solid fa-user-check"></i></button>
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
