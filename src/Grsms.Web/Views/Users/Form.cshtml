@* Add/edit a GREL staff account. Id = null means "add".
   The temporary password is required when adding, and optional when editing (fill it in to reset). *@
@model UserFormDto
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "Add staff account" : $"Edit {Model.FullName}";
    var allRoles = (IReadOnlyList<string>)ViewBag.AllRoles;
    var isSuperAdmin = ViewBag.IsSuperAdmin == true;
}

<div class="page-header">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</div>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card glass h-100">
                <div class="card-body p-4">
                    <h2 class="h6 text-uppercase text-body-secondary mb-3">Personal details</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StaffNumber" class="form-label"></label>
                            <input asp-for="StaffNumber" class="form-control text-uppercase" />
                            <span asp-validation-for="StaffNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DepartmentId" class="form-label"></label>
                            <select asp-for="DepartmentId" asp-items="ViewBag.DepartmentList" class="form-select">
                                <option value="">— None —</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SiteId" class="form-label"></label>
                            <select asp-for="SiteId" asp-items="ViewBag.SiteList" class="form-select">
                                <option value="">— None —</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TemporaryPassword" class="form-label"></label>
                            <input asp-for="TemporaryPassword" class="form-control" autocomplete="new-password" />
                            <div class="form-text">
                                @(isNew ? "Give this to the user privately." : "Leave empty to keep the current password. Fill in to reset it.")
                                They must change it at first sign-in. At least 10 characters with upper/lower case, a number and a symbol.
                            </div>
                            <span asp-validation-for="TemporaryPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsActive" class="form-check-input" role="switch" />
                                <label asp-for="IsActive" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card glass h-100">
                <div class="card-body p-4">
                    <h2 class="h6 text-uppercase text-body-secondary mb-3">Roles</h2>
                    <p class="small text-body-secondary">Tick every role this person needs. Changes take effect within 5 minutes.</p>
                    @if (!isSuperAdmin)
                    {
                        <p class="small text-body-secondary"><i class="fa-solid fa-lock me-1"></i>Roles with a lock can only be given by a Super Admin.</p>
                    }
                    @foreach (var role in allRoles)
                    {
                        var id = "role-" + role.Replace(' ', '-');
                        var locked = !isSuperAdmin && Roles.NeedsSuperAdmin([role]);
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role" id="@id"
                                   checked="@Model.SelectedRoles.Contains(role)" disabled="@locked" />
                            <label class="form-check-label" for="@id">
                                @role
                                @if (locked) { <i class="fa-solid fa-lock small text-body-secondary ms-1" title="Super Admin only"></i> }
                                @if (!Roles.IsBuiltIn(role)) { <span class="badge rounded-pill badge-soft-secondary ms-1">custom</span> }
                            </label>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Save</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
