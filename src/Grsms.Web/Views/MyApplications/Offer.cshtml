@* The candidate's offer letter: a printable page, with Accept / Decline while the offer is open. *@
@model MyOfferDto
@{
    ViewData["Title"] = $"Offer {Model.Number}";
    var gb = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
}

<div class="page-header d-print-none">
    <div>
        <h1>Your offer of employment</h1>
        <p>@Model.Number · <strong>@Model.Status.DisplayName()</strong></p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" data-print><i class="fa-solid fa-print me-1"></i>Print</button>
        <a asp-action="Details" asp-route-id="@ViewBag.ApplicationId" class="btn btn-outline-secondary">Back to my application</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <article class="card glass offer-letter">
            <div class="card-body p-4 p-md-5">
                <partial name="_LetterHead" />
                <p class="text-end small mb-4">Ref: @Model.Number<br />@Model.SentAt.ToString("d MMMM yyyy", gb)</p>
                <p>Dear @Model.CandidateName,</p>
                <h2 class="h5 my-3">Offer of employment: @Model.JobTitle</h2>
                <p>Following your recent application and interview, Ghana Rubber Estates Limited (GREL) is pleased to offer you the position of
                    <strong>@Model.JobTitle</strong> in the <strong>@Model.DepartmentName</strong> department, on the following terms:</p>
                <table class="table table-sm w-auto">
                    <tbody>
                    <tr><th scope="row">Position</th><td>@Model.JobTitle</td></tr>
                    <tr><th scope="row">Department</th><td>@Model.DepartmentName</td></tr>
                    <tr><th scope="row">Place of work</th><td>@Model.SiteName</td></tr>
                    @if (Model.ReportingTo is not null) { <tr><th scope="row">Reporting to</th><td>@Model.ReportingTo</td></tr> }
                    <tr><th scope="row">Monthly salary</th><td>GHS @Model.MonthlySalary.ToString("N2", gb) (gross)</td></tr>
                    <tr><th scope="row">Start date</th><td>@Model.StartDate.ToString("dddd d MMMM yyyy", gb)</td></tr>
                    </tbody>
                </table>
                @if (Model.Terms is not null)
                {
                    <div class="mb-3" style="white-space: pre-wrap">@Model.Terms</div>
                }
                <p>This offer is subject to the satisfactory completion of background checks already carried out and to GREL's conditions of service.
                    Your appointment letter will follow your acceptance.</p>
                <p>Please accept or decline this offer by <strong>@Model.ExpiresOn.ToString("d MMMM yyyy", gb)</strong>.</p>
                <p class="mb-0">Yours sincerely,<br /><br />Human Resources<br />Ghana Rubber Estates Limited</p>
            </div>
        </article>
    </div>

    <div class="col-xl-4 d-print-none">
        @if (Model.CanRespond)
        {
            <div class="card glass border border-primary mb-3">
                <div class="card-body p-4">
                    <h2 class="h6 text-uppercase text-body-secondary mb-3">Your reply</h2>
                    <form asp-action="RespondOffer" asp-route-id="@ViewBag.ApplicationId" method="post" class="mb-3">
                        <input type="hidden" name="accept" value="true" />
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="confirm" value="true" id="confirm" required />
                            <label class="form-check-label small" for="confirm">I have read the offer and accept it on these terms.</label>
                        </div>
                        <button type="submit" class="btn btn-success w-100"><i class="fa-solid fa-check me-1"></i>Accept the offer</button>
                    </form>
                    <form asp-action="RespondOffer" asp-route-id="@ViewBag.ApplicationId" method="post">
                        <input type="hidden" name="accept" value="false" />
                        <textarea name="reason" class="form-control form-control-sm mb-2" rows="2" maxlength="2000" placeholder="Reason (optional)" aria-label="Reason for declining"></textarea>
                        <button type="submit" class="btn btn-outline-danger w-100" data-confirm="Decline this offer? This cannot be undone.">Decline the offer</button>
                    </form>
                </div>
            </div>
        }
        else if (Model.Status == OfferStatus.Accepted)
        {
            <div class="alert alert-success">You accepted this offer on @Model.RespondedAt?.ToString("d MMMM yyyy", gb). Welcome to GREL!</div>
        }
        else if (Model.Status == OfferStatus.Sent)
        {
            <div class="alert alert-warning">The reply-by date has passed. Please contact the recruitment team.</div>
        }
    </div>
</div>
