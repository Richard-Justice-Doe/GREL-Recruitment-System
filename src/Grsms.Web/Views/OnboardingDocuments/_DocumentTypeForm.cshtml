@* Phase 27: one onboarding document type (edit an existing one, or add a new one when Id is null). *@
@model OnboardingDocumentTypeForm
@{
    var key = Model.Id?.ToString() ?? "new";
}
<form asp-controller="OnboardingDocuments" asp-action="Save" method="post" class="small">
    @if (Model.Id is int id)
    {
        <input type="hidden" name="Id" value="@id" />
        <input type="hidden" name="Version" value="@Model.Version" />
    }
    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
        <div class="flex-grow-1">
            <label class="form-label small mb-0" for="name-@key">Name</label>
            <input id="name-@key" name="Name" class="form-control form-control-sm" maxlength="150" required value="@Model.Name" />
        </div>
        @if (Model.Id is not null)
        {
            <span class="badge rounded-pill @(Model.IsActive ? "badge-soft-success" : "badge-soft-secondary") mt-3">@(Model.IsActive ? "Active" : "Retired")</span>
        }
    </div>
    <label class="form-label small mb-0" for="desc-@key">What the new employee must provide</label>
    <input id="desc-@key" name="Description" class="form-control form-control-sm mb-2" maxlength="500" value="@Model.Description" />
    <div class="row g-2 mb-2">
        <div class="col-sm-6">
            <label class="form-label small mb-0" for="group-@key">Group</label>
            <select id="group-@key" name="Group" class="form-select form-select-sm">
                @foreach (var g in Enum.GetValues<DocumentGroup>())
                {
                    <option value="@g" selected="@(g == Model.Group)">@g.DisplayName()</option>
                }
            </select>
        </div>
        <div class="col-sm-6">
            <label class="form-label small mb-0" for="req-@key">Required</label>
            <select id="req-@key" name="Requirement" class="form-select form-select-sm">
                @foreach (var r in Enum.GetValues<DocumentRequirement>())
                {
                    <option value="@r" selected="@(r == Model.Requirement)">@r.DisplayName()</option>
                }
            </select>
        </div>
        <div class="col-sm-4">
            <label class="form-label small mb-0" for="min-@key">Files needed</label>
            <input id="min-@key" name="MinFiles" type="number" min="1" max="@OnboardingWorkflow.MaxFilesPerDocument" class="form-control form-control-sm" value="@Model.MinFiles" />
        </div>
        <div class="col-sm-4">
            <label class="form-label small mb-0" for="cat-@key">Filed under</label>
            <select id="cat-@key" name="PersonnelFileCategoryId" class="form-select form-select-sm">
                @foreach (var c in PersonnelFileCategories.All)
                {
                    <option value="@c.Id" selected="@(c.Id == Model.PersonnelFileCategoryId)">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-sm-4">
            <label class="form-label small mb-0" for="order-@key">Order</label>
            <input id="order-@key" name="SortOrder" type="number" class="form-control form-control-sm" value="@Model.SortOrder" />
        </div>
    </div>
    <div class="d-flex flex-wrap gap-3 mb-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="AllowsWordFiles" value="true" id="word-@key" checked="@Model.AllowsWordFiles" />
            <input type="hidden" name="AllowsWordFiles" value="false" />
            <label class="form-check-label" for="word-@key">Word (.docx) files accepted</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="active-@key" checked="@Model.IsActive" />
            <input type="hidden" name="IsActive" value="false" />
            <label class="form-check-label" for="active-@key">Active (asked for)</label>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center">
        <button type="submit" class="btn btn-sm btn-outline-primary">@(Model.Id is null ? "Add the document" : "Save")</button>
        @if (Model.Id is not null)
        {
            <span class="text-body-secondary">@Model.InUse onboarding(s) in progress</span>
        }
    </div>
</form>
