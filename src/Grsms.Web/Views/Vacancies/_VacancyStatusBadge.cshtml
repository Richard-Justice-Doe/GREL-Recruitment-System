@* Coloured pill for a vacancy's status. Usage: <partial name="_VacancyStatusBadge" model="v.Status" /> *@
@model Grsms.Domain.Vacancies.VacancyStatus
@{
    var css = Model switch
    {
        Grsms.Domain.Vacancies.VacancyStatus.Draft => "badge-soft-secondary",
        Grsms.Domain.Vacancies.VacancyStatus.PendingApproval => "badge-soft-warning",
        Grsms.Domain.Vacancies.VacancyStatus.Published => "badge-soft-success",
        Grsms.Domain.Vacancies.VacancyStatus.Closed => "badge-soft-primary",
        _ => "badge-soft-secondary"
    };
}
<span class="badge rounded-pill @css">@Model.DisplayName()</span>
