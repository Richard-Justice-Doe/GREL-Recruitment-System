@* 12 November 2026: Administration → Letterhead & signature (offer and appointment letters). *@
@using Grsms.Application.Settings
@using Grsms.Domain.Settings
@model IReadOnlyList<SettingRowDto>
@{
    ViewData["Title"] = "Letterhead & signature";
    var canManage = ViewBag.CanManage == true;
    var details = (LetterDetails)ViewBag.Details;
}

<div class="page-header">
    <div>
        <h1>Letterhead &amp; signature</h1>
        <p>What the <strong>offer letter</strong> and the <strong>appointment letter</strong> print at the top and in the signature. Changes apply straight away and are recorded in the audit trail.</p>
    </div>
</div>

@if (!canManage)
{
    <div class="alert alert-secondary small"><i class="fa-solid fa-eye me-1"></i><strong>Read-only.</strong> Only a Super Admin can change these details.</div>
}

<div class="row g-3">
    <div class="col-xl-6">
        <form asp-action="Save" method="post" class="card glass h-100">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">Details</h2>
                <fieldset disabled="@(!canManage)">
                    @foreach (var r in Model)
                    {
                        var d = r.Definition;
                        var id = "f-" + d.Key.Replace(':', '-');
                        <div class="mb-3">
                            <label class="form-label" for="@id">@d.Label</label>
                            @switch (d.Kind)
                            {
                                case SettingKind.MultiLine:
                                    <textarea id="@id" name="@d.Key" class="form-control" rows="3" maxlength="@d.MaxLength">@r.Value</textarea>
                                    break;
                                case SettingKind.Email:
                                    <input id="@id" name="@d.Key" type="email" class="form-control" maxlength="@d.MaxLength" value="@r.Value" />
                                    break;
                                default:
                                    <input id="@id" name="@d.Key" type="text" class="form-control" maxlength="@d.MaxLength" value="@r.Value" />
                                    break;
                            }
                            <div class="form-text">@d.Help</div>
                        </div>
                    }
                </fieldset>
                @if (canManage)
                {
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Save</button>
                }
            </div>
        </form>
    </div>

    <div class="col-xl-6 d-flex flex-column gap-3">
        <div class="card glass">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">Scanned signature (optional)</h2>
                @if (details.HasSignature)
                {
                    <div class="letter-signature-preview mb-3">
                        <img src="@Url.Action("Signature", "LetterImages")" alt="Current signature" class="letter-signature" />
                    </div>
                    @if (canManage)
                    {
                        <form asp-action="RemoveSignature" method="post" class="mb-3">
                            <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Remove the signature from the letters?"><i class="fa-solid fa-trash me-1"></i>Remove signature</button>
                        </form>
                    }
                }
                else
                {
                    <p class="small text-body-secondary">No signature uploaded: the letters leave space to sign by hand when printed.</p>
                }
                @if (canManage)
                {
                    <form asp-action="UploadSignature" method="post" enctype="multipart/form-data">
                        <label class="form-label" for="signature">@(details.HasSignature ? "Replace with" : "Upload")</label>
                        <div class="input-group">
                            <input id="signature" name="signature" type="file" class="form-control" accept="image/png,image/jpeg" required />
                            <button type="submit" class="btn btn-outline-primary"><i class="fa-solid fa-upload me-1"></i>Upload</button>
                        </div>
                        <div class="form-text">PNG or JPEG, at most 1 MB. A signature on a white or transparent background, cropped close, works best.</div>
                    </form>
                }
            </div>
        </div>

        <div class="card glass">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-3">Preview</h2>
                <div class="letter-preview">
                    <partial name="_LetterHead" />
                    <p class="small text-body-secondary fst-italic">… the letter …</p>
                    <partial name="_LetterSignature" />
                </div>
            </div>
        </div>
    </div>
</div>
