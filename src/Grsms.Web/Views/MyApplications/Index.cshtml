@* "My applications": every application the signed-in person has sent, newest first. *@
@model IReadOnlyList<MyApplicationDto>
@{
    ViewData["Title"] = "My applications";
}

<div class="page-header">
    <div>
        <h1>My applications</h1>
        <p>Follow each application from received to the final outcome.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary"><i class="fa-regular fa-id-card me-1"></i>My profile</a>
        <a asp-controller="Careers" asp-action="Index" class="btn btn-primary"><i class="fa-solid fa-briefcase me-1"></i>Current vacancies</a>
    </div>
</div>

<div class="card glass">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-center py-4">
                <p class="mb-2">You have not applied for any vacancies yet.</p>
                <a asp-controller="Careers" asp-action="Index">See current vacancies</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 table-stack">
                    <thead><tr><th>Reference</th><th>Job</th><th>Department</th><th>Applied</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td data-label="Reference" class="text-nowrap"><a asp-action="Details" asp-route-id="@a.Id" class="fw-semibold text-decoration-none">@a.ApplicationNumber</a></td>
                            <td data-label="Job">@a.JobTitle</td>
                            <td data-label="Department">@a.DepartmentName</td>
                            <td data-label="Applied" class="small text-nowrap">@a.SubmittedAt.ToString("dd MMM yyyy")</td>
                            <td data-label="Status"><partial name="_ApplicationStatus" model="a.Status" /></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
