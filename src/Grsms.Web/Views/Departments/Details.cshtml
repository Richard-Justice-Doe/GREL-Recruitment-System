@* One department: its details, its units, and buttons to edit / deactivate. *@
@model DepartmentDetailsDto
@{
    ViewData["Title"] = Model.Name;
}

<div class="page-header">
    <div>
        <h1>@Model.Name <partial name="_ActiveBadge" model="Model.IsActive" /></h1>
        <p>Code <code>@Model.Code</code></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-back"><i class="fa-solid fa-arrow-left me-1"></i>All departments</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="fa-solid fa-pen me-1"></i>Edit</a>
        <form asp-action="SetActive" asp-route-id="@Model.Id" method="post">
            <input type="hidden" name="active" value="@(!Model.IsActive)" />
            <input type="hidden" name="returnTo" value="details" />
            @if (Model.IsActive)
            {
                <button type="submit" class="btn btn-outline-danger" data-confirm="Deactivate @Model.Name?">Deactivate</button>
            }
            else
            {
                <button type="submit" class="btn btn-outline-success">Activate</button>
            }
        </form>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card glass h-100">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-body-secondary">Details</h2>
                <dl class="mb-0">
                    <dt>Division</dt>
                    <dd>@Model.DivisionName</dd>
                    <dt>Head of Department</dt>
                    <dd>@(Model.HeadOfDepartmentName ?? "Not assigned")</dd>
                    <dt>Description</dt>
                    <dd>@(Model.Description ?? "—")</dd>
                    <dt>Created</dt>
                    <dd class="small">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm") by @Model.CreatedBy</dd>
                    @if (Model.UpdatedAt is not null)
                    {
                        <dt>Last changed</dt>
                        <dd class="small">@Model.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm") by @Model.UpdatedBy</dd>
                    }
                </dl>
                <a asp-controller="AuditLogs" asp-action="Index" asp-route-entityName="Department" asp-route-entityId="@Model.Id" class="small">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i>View change history
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card glass h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 text-uppercase text-body-secondary mb-0">Units (@Model.Units.Count)</h2>
                    @if (Model.IsActive)
                    {
                        <a asp-controller="Units" asp-action="Create" asp-route-departmentId="@Model.Id" class="btn btn-sm btn-primary">
                            <i class="fa-solid fa-plus me-1"></i>Add unit
                        </a>
                    }
                </div>
                @if (Model.Units.Count == 0)
                {
                    <p class="text-body-secondary mb-0">No units yet. Add the sub-sections of this department (for example Payroll or Treasury in Finance).</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead><tr><th>Unit</th><th>Code</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                            <tbody>
                            @foreach (var u in Model.Units)
                            {
                                <tr class="@(u.IsActive ? "" : "row-inactive")">
                                    <td>@u.Name</td>
                                    <td><code>@u.Code</code></td>
                                    <td><partial name="_ActiveBadge" model="u.IsActive" /></td>
                                    <td class="text-end text-nowrap">
                                        <a asp-controller="Units" asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                        <form asp-controller="Units" asp-action="SetActive" asp-route-id="@u.Id" method="post" class="d-inline">
                                            <input type="hidden" name="active" value="@(!u.IsActive)" />
                                            <input type="hidden" name="departmentId" value="@Model.Id" />
                                            @if (u.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate" data-confirm="Deactivate unit @u.Name?"><i class="fa-solid fa-ban"></i></button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Activate"><i class="fa-solid fa-check"></i></button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
