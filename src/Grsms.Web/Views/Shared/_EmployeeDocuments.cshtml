@* The new-hire document checklist, shared by the RO's onboarding page and the new employee's portal (Phase 18; Phase 27:
   configurable types grouped by heading, per-document review, replace with history, rejection reasons).
   ViewData["DocController"] = the controller that handles the posts ("Onboarding" for HR, "MyApplications" for the employee);
   ViewData["DocRouteId"]   = the id those actions expect (the onboarding id for HR, the application id for the employee).
   Each document only shows what the current user may do with it (CanEdit / CanReview / CanStartReview, from the service).

   14 November 2026 (user's request "make it nice and lively, less scrolling"): a progress bar with filter chips; groups that fold,
   open only when something in them needs the viewer; one compact row per document (status icon, name, files, warnings, status)
   that opens to show the files, actions and history. Rows needing the viewer's action open by themselves. Behaviour unchanged.
   js/document-checklist.js does the filtering and re-opens the document named in the address (#doc-12) after an upload. *@
@model DocumentChecklistDto
@{
    var controller = (string)ViewData["DocController"]!;
    var routeId = (int)ViewData["DocRouteId"]!;
    var forEmployee = controller == "MyApplications";
    var docs = forEmployee ? Model.Visible : Model.Documents;
    string Css(EmployeeDocumentDto d) => d.Status switch
    {
        EmployeeDocumentStatus.Verified => "badge-soft-success",
        EmployeeDocumentStatus.Rejected => "badge-soft-danger",
        EmployeeDocumentStatus.Submitted or EmployeeDocumentStatus.Resubmitted => "badge-soft-primary",
        EmployeeDocumentStatus.UnderReview => "badge-soft-info",
        EmployeeDocumentStatus.NotApplicable when d.NotApplicableAccepted => "badge-soft-success",
        EmployeeDocumentStatus.NotApplicable => "badge-soft-secondary",
        _ => d.IsRequired ? "badge-soft-warning" : "badge-soft-secondary"
    };
    string Size(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.0} MB" : $"{Math.Max(1, bytes / 1024)} KB";
    string Types(EmployeeDocumentDto d) => string.Join(", ", d.FileTypes.Select(t => t.TrimStart('.').ToUpperInvariant()));

    // The state of a document, for its icon and the filter chips.
    string State(EmployeeDocumentDto d) => d.Status switch
    {
        EmployeeDocumentStatus.Verified => "done",
        EmployeeDocumentStatus.NotApplicable when d.NotApplicableAccepted => "done",
        EmployeeDocumentStatus.Rejected => "rejected",
        EmployeeDocumentStatus.Pending when d.IsRequired && d.IsApplicable => "missing",
        EmployeeDocumentStatus.Pending => "optional",
        _ => "review"
    };
    // Does it wait for the person looking at it?
    bool Mine(EmployeeDocumentDto d) => forEmployee
        ? d.CanEdit && (d.Status == EmployeeDocumentStatus.Rejected || (d.Status == EmployeeDocumentStatus.Pending && d.IsRequired && d.IsApplicable))
        : d.CanStartReview || d.CanReview;
    (string Icon, string Tone) Look(string state) => state switch
    {
        "done" => ("fa-check", "ok"),
        "rejected" => ("fa-xmark", "bad"),
        "missing" => ("fa-arrow-up-from-bracket", "todo"),
        "optional" => ("fa-minus", "muted"),
        _ => ("fa-hourglass-half", "wait")
    };

    var counted = docs.Where(d => d.IsApplicable && (d.IsRequired || d.Status != EmployeeDocumentStatus.Pending)).ToList();
    var done = counted.Count(d => State(d) == "done");
    var percent = counted.Count == 0 ? 0 : (int)Math.Round(done * 100.0 / counted.Count);
    var counts = docs.GroupBy(State).ToDictionary(g => g.Key, g => g.Count());
    var mineCount = docs.Count(Mine);
    // Only the first document waiting for the viewer opens by itself (the others show "Your action" on their row); a new
    // employee also sees their rejected documents open.
    var firstMineId = docs.FirstOrDefault(Mine)?.Id;

    // Several "same file as …" remarks become one line; other remarks stay as they are.
    IEnumerable<Grsms.Application.Onboarding.DocumentFlag> Remarks(EmployeeDocumentDto d)
    {
        var flags = (d.Flags ?? []).Where(f => f.Code != "no-expiry").ToList();
        var same = flags.Where(f => f.Code == "duplicate").Select(f => f.Message.Replace("The same file is also uploaded as ", "").TrimEnd('.')).ToList();
        foreach (var f in flags.Where(f => f.Code != "duplicate")) yield return f;
        if (same.Count > 0)
            yield return new Grsms.Application.Onboarding.DocumentFlag("duplicate", "warning", $"The same file is also uploaded as {string.Join(", ", same)}.");
    }
}

<div class="doc-checklist" data-doc-checklist>
    <div class="doc-head">
        <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2">
            <h2 class="h6 text-uppercase text-body-secondary mb-0">Onboarding documents</h2>
            <span class="small"><strong>@done of @counted.Count</strong> complete</span>
        </div>
        <div class="progress doc-progress my-2" role="progressbar" aria-label="Documents complete" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width:@percent%"></div>
        </div>
        <p class="small text-body-secondary mb-2">
            @if (forEmployee)
            {
                <text>Upload a clear scan or photo of each document (up to 10 MB). Each one is checked as soon as you upload it. You can replace a file until it is verified.</text>
            }
            else
            {
                <text>Documents arrive one by one. <em>Start review</em> locks a document while you check it; verify it against the original, or reject it with the reason (the new employee is emailed).</text>
            }
        </p>
        <div class="doc-filters" role="group" aria-label="Show">
            <button type="button" class="doc-chip is-active" data-doc-filter="all">All <span>@docs.Count</span></button>
            @if (mineCount > 0)
            {
                <button type="button" class="doc-chip chip-mine" data-doc-filter="mine"><i class="fa-solid fa-bolt me-1"></i>Needs your action <span>@mineCount</span></button>
            }
            @foreach (var (key, label) in new[] { ("review", forEmployee ? "Being checked" : "Waiting for review"), ("rejected", "Rejected"), ("missing", "Missing"), ("done", forEmployee ? "Accepted" : "Verified") })
            {
                @if (counts.GetValueOrDefault(key) > 0)
                {
                    <button type="button" class="doc-chip chip-@key" data-doc-filter="@key">@label <span>@counts[key]</span></button>
                }
            }
        </div>
    </div>

    @foreach (var group in docs.GroupBy(d => d.Group))
    {
        var gCounted = group.Where(d => d.IsApplicable && (d.IsRequired || d.Status != EmployeeDocumentStatus.Pending)).ToList();
        var gDone = gCounted.Count(d => State(d) == "done");
        var gOpen = group.Any(Mine) || group.Any(d => State(d) is "rejected" or "missing");
        <details class="doc-group" open="@gOpen" data-doc-group>
            <summary>
                <span class="doc-group-name">@group.Key.DisplayName()</span>
                <span class="doc-group-count @(gCounted.Count > 0 && gDone == gCounted.Count ? "is-complete" : "")">
                    @if (gCounted.Count > 0 && gDone == gCounted.Count) { <i class="fa-solid fa-circle-check me-1"></i> }@gDone/@gCounted.Count done
                </span>
                <i class="fa-solid fa-chevron-down doc-chevron" aria-hidden="true"></i>
            </summary>

            @foreach (var d in group)
            {
                var state = State(d);
                var (icon, tone) = Look(state);
                var mine = Mine(d);
                var warn = Remarks(d).Where(f => f.Severity != "info").ToList();
                <details class="doc-item tone-@tone @(mine ? "is-mine" : "") @(!d.IsApplicable ? "is-retired" : "")" id="doc-@d.Id"
                         data-doc-state="@state" data-doc-mine="@(mine ? "true" : "false")" open="@(d.Id == firstMineId || (forEmployee && state == "rejected"))">
                    <summary>
                        <span class="doc-icon" aria-hidden="true"><i class="fa-solid @icon"></i></span>
                        <span class="doc-title">
                            <strong>@d.Name</strong>
                            @if (!d.IsApplicable) { <small class="text-body-secondary">(no longer required)</small> }
                            else if (!d.IsRequired) { <small class="text-body-secondary">(optional)</small> }
                            <small class="doc-meta">
                                @if (d.Files.Count > 0) { <span><i class="fa-regular fa-file me-1"></i>@d.Files.Count file@(d.Files.Count == 1 ? "" : "s")</span> }
                                @if (d.MinFiles > 1 && d.Files.Count < d.MinFiles) { <span>@d.MinFiles needed</span> }
                                @if (warn.Count > 0) { <span class="text-@(warn.Any(f => f.Severity == "danger") ? "danger" : "warning-emphasis")"><i class="fa-solid fa-triangle-exclamation me-1"></i>@warn.Count check@(warn.Count == 1 ? "" : "s")</span> }
                                @if (mine) { <span class="doc-you">@(forEmployee ? "Your turn" : "Your action")</span> }
                            </small>
                        </span>
                        <span class="badge rounded-pill @Css(d) text-wrap">@(d.NotApplicableAccepted ? "Not applicable (accepted)" : d.Status.DisplayName())</span>
                        <i class="fa-solid fa-chevron-down doc-chevron" aria-hidden="true"></i>
                    </summary>

                    <div class="doc-body small">
                        @if (d.Description is not null) { <div class="text-body-secondary">@d.Description</div> }
                        @if (d.Status == EmployeeDocumentStatus.NotApplicable)
                        {
                            <div class="text-body-secondary">Not applicable: @d.NotApplicableReason</div>
                        }
                        @if (d.Status == EmployeeDocumentStatus.Rejected)
                        {
                            <div class="text-danger"><i class="fa-solid fa-circle-exclamation me-1"></i>Rejected: @d.RejectionReason</div>
                        }
                        @if (d.Status == EmployeeDocumentStatus.UnderReview)
                        {
                            <div class="text-body-secondary">Under review@(d.ReviewStartedBy is null ? "" : $" by {d.ReviewStartedBy}") since @d.ReviewStartedAt?.ToString("dd MMM yyyy HH:mm")</div>
                        }
                        @if (d.VerifiedAt is not null && d.Status is EmployeeDocumentStatus.Verified or EmployeeDocumentStatus.NotApplicable)
                        {
                            <div class="text-body-secondary"><i class="fa-solid fa-check text-success me-1"></i>@(d.Status == EmployeeDocumentStatus.Verified ? "Verified" : "Accepted")@(d.VerifiedBy is null ? "" : $" by {d.VerifiedBy}"), @d.VerifiedAt?.ToString("dd MMM yyyy")</div>
                        }
                        @if (!forEmployee && d.RejectionCount > 0 && d.Status != EmployeeDocumentStatus.Rejected)
                        {
                            <div class="text-body-secondary">Rejected @d.RejectionCount time(s) before</div>
                        }
                        @* docs/36 AI-4: "valid until" of ID-type documents, and the automatic checks (rules, no AI). *@
                        @if (d.HasExpiry && d.IsApplicable)
                        {
                            <div class="text-body-secondary">Valid until: @(d.ExpiresOn?.ToString("d MMM yyyy") ?? "not given")
                                @if (d.CanEdit || d.CanReview || d.CanStartReview)
                                {
                                    <details class="d-inline-block ms-1">
                                        <summary class="d-inline">@(d.ExpiresOn is null ? "add" : "change")</summary>
                                        <form asp-controller="@controller" asp-action="SetDocumentExpiry" asp-route-id="@routeId" method="post" class="mt-1">
                                            <input type="hidden" name="documentId" value="@d.Id" />
                                            <div class="input-group input-group-sm">
                                                <input type="date" name="expiresOn" class="form-control" value="@d.ExpiresOn?.ToString("yyyy-MM-dd")" aria-label="Valid until for @d.Name" />
                                                <button type="submit" class="btn btn-outline-secondary">Save</button>
                                            </div>
                                        </form>
                                    </details>
                                }
                            </div>
                        }
                        @* The "no valid-until date" remark is already said by the line above. *@
                        @foreach (var flag in Remarks(d))
                        {
                            <div class="text-@(flag.Severity == "info" ? "body-secondary" : flag.Severity == "warning" ? "warning-emphasis" : "danger")" data-doc-flag="@flag.Code">
                                <i class="fa-solid @(flag.Severity == "danger" ? "fa-triangle-exclamation" : flag.Severity == "warning" ? "fa-circle-exclamation" : "fa-circle-info") me-1"></i>@flag.Message
                            </div>
                        }

                        @if (d.Files.Count > 0)
                        {
                            <ul class="doc-files list-unstyled mb-0 mt-2">
                                @foreach (var f in d.Files)
                                {
                                    <li>
                                        <i class="fa-regular @(f.FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ? "fa-file-pdf" : f.FileName.EndsWith(".docx", StringComparison.OrdinalIgnoreCase) ? "fa-file-word" : "fa-file-image")"></i>
                                        <a asp-controller="@controller" asp-action="DownloadDocument" asp-route-id="@routeId" asp-route-documentId="@d.Id" asp-route-attachmentId="@f.AttachmentId"
                                           class="text-decoration-none text-break">@f.FileName</a>
                                        <partial name="_PreviewButton" model='((string?)Url.Action("DownloadDocument", controller, new { id = routeId, documentId = d.Id, attachmentId = f.AttachmentId }), (string?)f.FileName)' />
                                        <span class="text-body-secondary">@Size(f.SizeBytes) · @f.UploadedAt.ToString("dd MMM yyyy")</span>
                                        @if (d.CanEdit)
                                        {
                                            <details class="ms-auto">
                                                <summary class="text-body-secondary">Replace</summary>
                                                <form asp-controller="@controller" asp-action="UploadDocument" asp-route-id="@routeId" method="post" enctype="multipart/form-data" class="mt-1">
                                                    <input type="hidden" name="documentId" value="@d.Id" />
                                                    <input type="hidden" name="replacesAttachmentId" value="@f.AttachmentId" />
                                                    <div class="input-group input-group-sm">
                                                        <input type="file" name="file" class="form-control" accept="@d.Accept" required aria-label="Replacement for @f.FileName" />
                                                        <button type="submit" class="btn btn-outline-primary">Replace</button>
                                                    </div>
                                                </form>
                                                <form asp-controller="@controller" asp-action="RemoveDocumentFile" asp-route-id="@routeId" method="post" class="mt-1">
                                                    <input type="hidden" name="documentId" value="@d.Id" />
                                                    <input type="hidden" name="attachmentId" value="@f.AttachmentId" />
                                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0" data-confirm="Remove @f.FileName? It stays in the history.">Remove this file</button>
                                                </form>
                                            </details>
                                        }
                                    </li>
                                }
                            </ul>
                        }

                        @if (d.CanAddFile)
                        {
                            <form asp-controller="@controller" asp-action="UploadDocument" asp-route-id="@routeId" method="post" enctype="multipart/form-data" class="mt-2 doc-upload">
                                <input type="hidden" name="documentId" value="@d.Id" />
                                <div class="input-group input-group-sm">
                                    <input type="file" name="file" class="form-control" accept="@d.Accept" required aria-label="File for @d.Name" data-upload-preview />
                                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-upload me-1"></i>@(d.Files.Count == 0 ? "Upload" : "Add a file")</button>
                                </div>
                                @if (d.HasExpiry && d.ExpiresOn is null)
                                {
                                    <label class="form-label small mt-1 mb-0" for="exp-@d.Id">Valid until (as printed on the document)</label>
                                    <input id="exp-@d.Id" type="date" name="expiresOn" class="form-control form-control-sm w-auto" />
                                }
                                <div class="form-text">@(forEmployee ? "Take a photo or choose a file · " : "")@Types(d), up to 10 MB</div>
                            </form>
                        }
                        @if (d.CanMarkNotApplicable)
                        {
                            <details class="mt-1">
                                <summary class="text-body-secondary">This does not apply to me</summary>
                                <form asp-controller="@controller" asp-action="MarkNotApplicable" asp-route-id="@routeId" method="post" class="mt-1">
                                    <input type="hidden" name="documentId" value="@d.Id" />
                                    <div class="input-group input-group-sm">
                                        <input name="reason" class="form-control" maxlength="500" required placeholder="Why (e.g. not married)" aria-label="Why it does not apply" />
                                        <button type="submit" class="btn btn-outline-secondary">Mark not applicable</button>
                                    </div>
                                </form>
                            </details>
                        }

                        @if (d.CanStartReview || d.CanReview)
                        {
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @if (d.CanStartReview)
                                {
                                    <form asp-controller="@controller" asp-action="StartReview" asp-route-id="@routeId" method="post">
                                        <input type="hidden" name="documentId" value="@d.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-magnifying-glass me-1"></i>Start review</button>
                                    </form>
                                }
                                @if (d.CanReview)
                                {
                                    <form asp-controller="@controller" asp-action="VerifyDocument" asp-route-id="@routeId" method="post">
                                        <input type="hidden" name="documentId" value="@d.Id" />
                                        <button type="submit" class="btn btn-sm btn-success"><i class="fa-solid fa-check me-1"></i>@(d.Status == EmployeeDocumentStatus.NotApplicable ? "Accept" : "Verified against the original")</button>
                                    </form>
                                    <form asp-controller="@controller" asp-action="RejectDocument" asp-route-id="@routeId" method="post" class="flex-grow-1">
                                        <input type="hidden" name="documentId" value="@d.Id" />
                                        <div class="input-group input-group-sm">
                                            <select name="reasonCode" class="form-select" required aria-label="Reason for rejecting" style="max-width: 13rem">
                                                <option value="">Reason…</option>
                                                @foreach (var r in Enum.GetValues<DocumentRejectionReason>())
                                                {
                                                    <option value="@r">@r.DisplayName()</option>
                                                }
                                            </select>
                                            <input name="reason" class="form-control" maxlength="900" placeholder="Note (required for Other)" aria-label="Note for the new employee" />
                                            <button type="submit" class="btn btn-outline-danger">Reject</button>
                                        </div>
                                    </form>
                                }
                            </div>
                        }

                        @if (d.History.Count > 0 || d.ReplacedFiles.Count > 0)
                        {
                            <details class="mt-2">
                                <summary class="text-body-secondary">History (@d.History.Count)</summary>
                                <ul class="list-unstyled mb-0 mt-1 ps-2 border-start">
                                    @foreach (var h in d.History)
                                    {
                                        <li>
                                            <span class="text-body-secondary">@h.ActionAt.ToString("dd MMM yyyy HH:mm")</span>
                                            · <strong>@h.Action.DisplayName()</strong> by @h.ActorName
                                            @if (h.FileName is not null) { <span>· @h.FileName</span> }
                                            @if (h.FromStatus != h.ToStatus) { <span class="text-body-secondary">· @h.FromStatus.DisplayName() → @h.ToStatus.DisplayName()</span> }
                                            @if (h.RejectionReason is { } rr) { <span>· @rr.DisplayName()</span> }
                                            @if (h.Comments is not null) { <span>· @h.Comments</span> }
                                        </li>
                                    }
                                </ul>
                                @if (d.ReplacedFiles.Count > 0)
                                {
                                    <div class="mt-1">Earlier files:</div>
                                    <ul class="list-unstyled mb-0 ps-2">
                                        @foreach (var f in d.ReplacedFiles)
                                        {
                                            <li>
                                                <a asp-controller="@controller" asp-action="DownloadDocument" asp-route-id="@routeId" asp-route-documentId="@d.Id" asp-route-attachmentId="@f.AttachmentId"
                                                   class="text-decoration-none text-break">@f.FileName</a>
                                                <span class="text-body-secondary">· @f.UploadedAt.ToString("dd MMM yyyy")</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </details>
                        }
                    </div>
                </details>
            }
        </details>
    }
    <p class="small text-body-secondary mt-2 mb-0 d-none" data-doc-none>No documents in this view.</p>
</div>
