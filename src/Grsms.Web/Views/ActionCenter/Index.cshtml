@* docs/37 CR5 (step C3): the Action Center: every pending action of the signed-in staff member, by priority. Built from the same
   queries as "My tasks" on Home (Application/Process/ActionCenterService). *@
@using Grsms.Application.Process
@using Grsms.Web.Helpers
@model ActionCenterDto
@{
    ViewData["Title"] = "Action Center";
    var gb = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
    var filter = ViewBag.Priority as ActionPriority?;
    var shown = filter is { } f ? Model.Items.Where(i => i.Priority == f).ToList() : Model.Items.ToList();
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var timed = shown.Select(i => (Item: i, Timing: i.TimingOn(today))).ToList();
    string PriorityCss(ActionPriority p) => p switch { ActionPriority.High => "badge-soft-danger", ActionPriority.Medium => "badge-soft-warning", _ => "badge-soft-secondary" };
}

<div class="page-header">
    <div>
        <h1>Action Center</h1>
        <p>Everything waiting for you, most urgent first, and what you have recently done. Deadlines follow the workflow targets in System settings.</p>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Filter by priority">
    <a asp-action="Index" class="btn btn-sm @(filter is null ? "btn-primary" : "btn-outline-secondary")">All <span class="badge text-bg-light ms-1">@Model.Items.Count</span></a>
    @foreach (var p in Enum.GetValues<ActionPriority>())
    {
        <a asp-action="Index" asp-route-priority="@p" class="btn btn-sm @(filter == p ? "btn-primary" : "btn-outline-secondary")"
           aria-current="@(filter == p ? "true" : null)">@p.DisplayName() <span class="badge @PriorityCss(p) ms-1">@Model.Count(p)</span></a>
    }
</div>


@* G2 (15 Nov 2026): the counts at a glance, then the actions in sections: overdue (red), due today (amber), coming up, and what
   you completed in the last two weeks (green). *@
<div class="ac-summary mb-3">
    <a href="#ac-overdue" class="ac-chip tone-danger"><span class="ac-chip-n">@timed.Count(x => x.Timing == ActionTiming.Overdue)</span>Overdue</a>
    <a href="#ac-today" class="ac-chip tone-warning"><span class="ac-chip-n">@timed.Count(x => x.Timing == ActionTiming.DueToday)</span>Due today</a>
    <a href="#ac-upcoming" class="ac-chip tone-neutral"><span class="ac-chip-n">@timed.Count(x => x.Timing == ActionTiming.Upcoming)</span>Coming up</a>
    <a href="#ac-done" class="ac-chip tone-success"><span class="ac-chip-n">@Model.Done.Count</span>Completed (@ActionCenterService.CompletedDays days)</a>
</div>

@if (shown.Count == 0)
{
    <div class="dash-card dash-empty"><i class="fa-regular fa-circle-check d-block"></i>@(filter is null ? "Nothing is waiting for you. Well done!" : $"No {filter.Value.DisplayName().ToLowerInvariant()}-priority actions.")</div>
}
@foreach (var (timing, anchor, css, icon) in new[] { (ActionTiming.Overdue, "ac-overdue", "is-overdue", "fa-triangle-exclamation"), (ActionTiming.DueToday, "ac-today", "is-today", "fa-hourglass-half"), (ActionTiming.Upcoming, "ac-upcoming", "is-upcoming", "fa-list-check") })
{
    var group = timed.Where(x => x.Timing == timing).Select(x => x.Item).ToList();
    if (group.Count == 0) { continue; }
    <h2 id="@anchor" class="ac-section @css"><i class="fa-solid @icon me-2" aria-hidden="true"></i>@timing.DisplayName() <span class="ac-section-n">@group.Count</span></h2>
    <div class="action-list mb-4">
        @foreach (var item in group)
        {
            var t = item.Task;
            var (tone, label, button) = TaskLinks.Look(t.Target);
            <article class="dash-card action-row @tone @css" data-priority="@item.Priority" data-timing="@timing">
                <div class="action-main">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <span class="badge rounded-pill @PriorityCss(item.Priority)">@item.Priority.DisplayName()</span>
                        <span class="small text-body-secondary">@label · @t.Reference</span>
                    </div>
                    <h3 class="h6 mb-1">@t.Action: <span class="fw-normal">@t.Title</span></h3>
                    <div class="small text-body-secondary">
                        @if (!string.IsNullOrWhiteSpace(t.PersonName)) { <span>@t.PersonName · </span> }
                        <span>since @t.Since.ToString("d MMM yyyy", gb)</span> · <span>@item.Why</span>
                        @if (item.DueDate is { } due)
                        {
                            <span> · expected by <strong class="@(due < today ? "text-danger" : "")">@due.ToString("ddd d MMM", gb)</strong></span>
                        }
                    </div>
                </div>
                <a href="@TaskLinks.Url(Url, t)" class="btn btn-sm btn-primary action-go">@button <i class="fa-solid fa-chevron-right ms-1"></i></a>
            </article>
        }
    </div>
}

<h2 id="ac-done" class="ac-section is-done"><i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>Completed in the last @ActionCenterService.CompletedDays days <span class="ac-section-n">@Model.Done.Count</span></h2>
@if (Model.Done.Count == 0)
{
    <p class="small text-body-secondary">Your approvals, reviews and other workflow actions will be listed here.</p>
}
else
{
    <ul class="ac-done-list">
        @foreach (var c in Model.Done)
        {
            <li>
                <i class="fa-solid fa-check" aria-hidden="true"></i>
                <a asp-controller="@c.Controller" asp-action="Details" asp-route-id="@c.Id">@c.What</a>
                <span class="small text-body-secondary">@c.Kind · @c.At.ToString("ddd d MMM, HH:mm", gb)</span>
            </li>
        }
    </ul>
}
