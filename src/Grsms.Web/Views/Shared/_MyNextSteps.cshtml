@* Usability U2 (10 November 2026): the candidate's or new employee's "Your next step": the first step big, with one button
   (on phones the button sticks to the bottom of the screen), the others as a short list. Steps come from MyNextStepService. *@
@model IReadOnlyList<MyNextStepDto>
@{
    string Url(MyNextStepDto s) => s.Target switch
    {
        MyStepTarget.Offer => Context.Request.PathBase + $"/MyApplications/Offer/{s.ApplicationId}",
        MyStepTarget.Appointment => Context.Request.PathBase + $"/MyApplications/Appointment/{s.ApplicationId}",
        MyStepTarget.PersonalRecord => Context.Request.PathBase + $"/MyApplications/PersonalRecord/{s.ApplicationId}",
        MyStepTarget.Documents => Context.Request.PathBase + $"/MyApplications/Documents/{s.ApplicationId}",
        MyStepTarget.Profile => Context.Request.PathBase + "/Profile",
        _ => Context.Request.PathBase + $"/MyApplications/Details/{s.ApplicationId}"
    };
}
@if (Model.Count > 0)
{
    var first = Model[0];
    <section class="next-step card glass border border-primary mb-3" aria-labelledby="next-step-title">
        <div class="card-body p-3 p-md-4">
            <div class="small text-uppercase text-body-secondary fw-semibold mb-1">Your next step</div>
            <h2 id="next-step-title" class="h5 mb-1">@first.Title</h2>
            <p class="mb-3 @(first.Urgent ? "text-danger-emphasis" : "text-body-secondary")">@first.Detail</p>
            <a href="@Url(first)" class="btn btn-primary btn-lg next-step-button">@first.Button <i class="fa-solid fa-arrow-right ms-1" aria-hidden="true"></i></a>
            @if (Model.Count > 1)
            {
                <h3 class="h6 mt-4 mb-2">Then</h3>
                <ul class="list-unstyled mb-0">
                    @foreach (var s in Model.Skip(1))
                    {
                        <li class="py-1 border-top">
                            <a href="@Url(s)" class="text-decoration-none d-flex justify-content-between align-items-center gap-2">
                                <span>@s.Title</span><i class="fa-solid fa-chevron-right small text-body-secondary" aria-hidden="true"></i>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>
}
