@* Left-hand navigation. Each link is shown only to people who may open it; the server checks again on every request,
   so hiding a link is for tidiness, not security. The small numbers on the right come from NavCounts (Helpers/NavCounts.cs).

   docs/32-33 (11 November 2026): the staff menu in five groups named after what is in them, in the order work flows:
     Recruitment  (Recruitment requests, Vacancies & adverts)
     Candidates   (Candidates = applications + screening + shortlisting, Interviews)
     Hiring       (Hiring & offers: recommendations and offers)
     Onboarding   (Onboarding: documents, verification, induction; Probation and confirmation)
     Employees    (Employees, Personnel files)
   then Administration (one page; Reports and survey results are on it since 11 November 2026). Same pages and addresses as before. Which group each
   page belongs to is in Helpers/MenuMap.cs (also used for the breadcrumb at the top of each page).
   Usability U1 (docs/28) still applies: staff's own "My applications / Job openings / My probation" live in the menu under
   their name; Heads of Department without a recruitment role don't see Screening or Hiring & offers (Helpers/MenuRules.cs);
   someone with 7 links or fewer gets one flat list, without group headings.
   A group is a <details> element: it opens and closes without script; site.js remembers which groups you opened. *@
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Auth
@inject NavCounts Nav
@inject MyNextStepService NextSteps
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(params string[] names) => names.Contains(controller) ? "active" : "";

    var canRequests = (await Auth.AuthorizeAsync(User, Policies.RecruitmentRequests)).Succeeded;
    var canVacancies = (await Auth.AuthorizeAsync(User, Policies.Vacancies)).Succeeded;
    var canAdverts = (await Auth.AuthorizeAsync(User, Policies.Adverts)).Succeeded;
    var canApplications = (await Auth.AuthorizeAsync(User, Policies.Applications)).Succeeded;
    var canPersonnelFiles = (await Auth.AuthorizeAsync(User, Policies.PersonnelFiles)).Succeeded;
    var canEmployees = (await Auth.AuthorizeAsync(User, Policies.Employees)).Succeeded; // Phase 28
    var canExecutive = (await Auth.AuthorizeAsync(User, Policies.ExecutiveDashboard)).Succeeded; // docs/36 AI-3
    var adminLinks = await Grsms.Web.Controllers.AdministrationController.VisibleAsync(Auth, User);
    var isStaff = (await Auth.AuthorizeAsync(User, Policies.Staff)).Succeeded;
    var hodOnly = MenuRules.IsHodOnly(User);
    var counts = await Nav.GetAsync();

    var showOnboarding = canApplications || counts.OnboardingTasksToDo is > 0;
    var showScreening = canApplications && !hodOnly;
    var showHiring = canApplications && !hodOnly;

    // How many links each group has, to choose between groups and one flat list.
    var recruitmentLinks = new[] { canRequests, canVacancies || canAdverts }.Count(x => x);
    var candidateLinks = new[] { canApplications, isStaff }.Count(x => x);
    var hiringLinks = showHiring ? 1 : 0;
    var onboardingLinks = new[] { showOnboarding, canApplications }.Count(x => x);
    var employeeLinks = new[] { canEmployees, canPersonnelFiles }.Count(x => x);
    var otherLinks = adminLinks.Count > 0 ? 1 : 0; // Administration (with Reports since 11 Nov 2026)
    var flat = !isStaff || recruitmentLinks + candidateLinks + hiringLinks + onboardingLinks + employeeLinks + otherLinks <= 7;

    var current = MenuMap.For(controller, action)?.Group;
    // Every screen listed on the Administration page (one list, in AdministrationController).
    var inAdmin = controller == "Administration" || Grsms.Web.Controllers.AdministrationController.ScreenFor(controller, action) is not null;

    // Badge totals on a group's header, so nothing waiting for you is hidden when the group is closed.
    var recruitmentWaiting = counts.RequestsAwaitingMe ?? 0;
    var candidatesWaiting = (showScreening ? counts.AtsAwaitingHr ?? 0 : 0) + (counts.ScorecardsToDo ?? 0);
    var onboardingWaiting = counts.OnboardingTasksToDo ?? 0;
}
@functions {
    // The opening of a group (nothing in a flat menu). The closing is GroupEnd.
    private Microsoft.AspNetCore.Html.IHtmlContent GroupStart(bool flat, string key, string label, string? current, int waiting)
    {
        if (flat) return Microsoft.AspNetCore.Html.HtmlString.Empty;
        var badge = waiting > 0 ? $"<span class=\"nav-count attention group-count\" title=\"Waiting for you\">{waiting}</span>" : "";
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<details class=\"nav-group group-{key}\" data-nav-group=\"{key}\" data-nav-current=\"{(current == label ? "yes" : "no")}\" open>" +
            $"<summary><span class=\"group-dot\" aria-hidden=\"true\"></span> {System.Net.WebUtility.HtmlEncode(label)} {badge}" +
            "<i class=\"fa-solid fa-chevron-down group-chevron\" aria-hidden=\"true\"></i></summary>");
    }

    private Microsoft.AspNetCore.Html.IHtmlContent GroupEnd(bool flat) =>
        flat ? Microsoft.AspNetCore.Html.HtmlString.Empty : new Microsoft.AspNetCore.Html.HtmlString("</details>");
}
<aside class="sidebar" aria-label="Main menu">
    <a class="brand" asp-controller="Home" asp-action="Index">
        <span class="brand-mark brand-logo"><img src="~/images/grel-mark.png" alt="GREL" /></span>
        <span>GREL Recruitment<small>Hire · Onboard · Grow</small></span>
    </a>

    <nav class="nav flex-column">
        <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">
            <i class="fa-solid fa-house"></i> Home
        </a>
        <a class="nav-link @Active("ActionCenter")" asp-controller="ActionCenter" asp-action="Index">
            <i class="fa-solid fa-list-check"></i> Action Center
        </a>
        @if (canExecutive)
        {
            <a class="nav-link @Active("Executive")" asp-controller="Executive" asp-action="Index">
                <i class="fa-solid fa-chart-pie"></i> Executive dashboard
            </a>
        }

        @if (!isStaff)
        {
            @* Candidates (and anyone without a staff role): their whole menu, flat. *@
            <a class="nav-link @Active("Careers")" asp-controller="Careers" asp-action="Index">
                <i class="fa-solid fa-magnifying-glass"></i> Current vacancies
            </a>
            @* Phase 27 stage B / usability U2: shown while the candidate has an onboarding in progress. *@
            var myOnboarding = await NextSteps.MyOnboardingAsync();
            var onOnboardingPage = myOnboarding is not null && controller == "MyApplications" && action is "Documents" or "PersonalRecord" or "Appointment";
            if (myOnboarding is not null)
            {
                <a class="nav-link @(onOnboardingPage ? "active" : "")" asp-controller="MyApplications" asp-action="Documents" asp-route-id="@myOnboarding.ApplicationId">
                    <i class="fa-solid fa-door-open"></i> My onboarding
                    <span class="nav-count" title="Your onboarding progress">@myOnboarding.Percent%</span>
                </a>
            }
            <a class="nav-link @(controller == "MyApplications" && !onOnboardingPage ? "active" : "")" asp-controller="MyApplications" asp-action="Index">
                <i class="fa-regular fa-paper-plane"></i> My applications
            </a>
            <a class="nav-link @Active("Profile")" asp-controller="Profile" asp-action="Index">
                <i class="fa-regular fa-id-card"></i> My profile
            </a>
        }

        @* ---- Recruitment *@
        @if (recruitmentLinks > 0)
        {
            @GroupStart(flat, "recruitment", "Recruitment", current, recruitmentWaiting)
            if (canRequests)
            {
                <a class="nav-link @Active("RecruitmentRequests")" asp-controller="RecruitmentRequests" asp-action="Index">
                    <i class="fa-regular fa-file-lines"></i> Recruitment requests
                    @if (counts.RequestsAwaitingMe is > 0)
                    {
                        <span class="nav-count attention" title="Awaiting your decision">@counts.RequestsAwaitingMe</span>
                    }
                </a>
            }
            if (canVacancies || canAdverts)
            {
                @* Vacancies and job adverts: one item, tabs switch between them (Views/Shared/_VacanciesAndAdvertsTabs.cshtml). *@
                <a class="nav-link @Active("Vacancies", "Adverts")" asp-controller="@(canVacancies ? "Vacancies" : "Adverts")" asp-action="Index">
                    <i class="fa-solid fa-briefcase"></i> @(canVacancies && canAdverts ? "Vacancies & adverts" : canVacancies ? "Vacancies" : "Job adverts")
                    @if (counts.OpenVacancies is int openCount)
                    {
                        <span class="nav-count" title="Open vacancies">@openCount</span>
                    }
                </a>
            }
            @GroupEnd(flat)
        }

        @* ---- Candidates *@
        @if (candidateLinks > 0)
        {
            @GroupStart(flat, "candidates", "Candidates", current, candidatesWaiting)
            if (canApplications)
            {
                @* Applications, screening (ATS) and shortlisting: one item, tabs switch between them (Views/Shared/_CandidatesTabs.cshtml). *@
                <a class="nav-link @(Active("Applications", "Shortlisting", "TalentPool") is "active" || (controller == "Ats" && action != "Settings") ? "active" : "")" asp-controller="Applications" asp-action="Index">
                    <i class="fa-solid fa-inbox"></i> Candidates
                    @if (showScreening && counts.AtsAwaitingHr is > 0)
                    {
                        <span class="nav-count attention" title="Automatic rejections waiting for HR">@counts.AtsAwaitingHr</span>
                    }
                </a>
            }
            if (isStaff)
            {
                @* Any staff member can sit on an interview panel (Phase 7). *@
                <a class="nav-link @Active("Interviews")" asp-controller="Interviews" asp-action="Index">
                    <i class="fa-solid fa-people-group"></i> Interviews
                    @if (counts.ScorecardsToDo is > 0)
                    {
                        <span class="nav-count attention" title="Scorecards to submit or validate">@counts.ScorecardsToDo</span>
                    }
                </a>
            }
            @GroupEnd(flat)
        }

        @* ---- Hiring *@
        @if (hiringLinks > 0)
        {
            @GroupStart(flat, "hiring", "Hiring", current, 0)
            <a class="nav-link @Active("Hiring")" asp-controller="Hiring" asp-action="Index">
                <i class="fa-solid fa-handshake"></i> Hiring &amp; offers
            </a>
            @GroupEnd(flat)
        }

        @* ---- Onboarding (documents, verification and induction on each onboarding; then probation) *@
        @if (onboardingLinks > 0)
        {
            @GroupStart(flat, "onboarding", "Onboarding", current, onboardingWaiting)
            if (showOnboarding)
            {
                @* HR and HODs follow every onboarding; anyone else sees the link while they have checklist items. *@
                <a class="nav-link @Active("Onboarding")" asp-controller="Onboarding" asp-action="Index"
                   asp-route-tab="@(counts.OnboardingTasksToDo is > 0 ? "tasks" : "progress")">
                    <i class="fa-solid fa-door-open"></i> Onboarding
                    @if (counts.OnboardingTasksToDo is > 0)
                    {
                        <span class="nav-count attention" title="Onboarding tasks waiting for you">@counts.OnboardingTasksToDo</span>
                    }
                </a>
            }
            if (canApplications)
            {
                <a class="nav-link @Active("Probation")" asp-controller="Probation" asp-action="Index" asp-route-tab="due">
                    <i class="fa-solid fa-user-clock"></i> Probation
                </a>
            }
            @GroupEnd(flat)
        }

        @* ---- Employees (Phase 28 onward: the HR platform after hiring) *@
        @if (employeeLinks > 0)
        {
            @GroupStart(flat, "employees", "Employees", current, 0)
            if (canEmployees)
            {
                <a class="nav-link @Active("Employees")" asp-controller="Employees" asp-action="Index">
                    <i class="fa-solid fa-id-card-clip"></i> Employees
                </a>
            }
            if (canPersonnelFiles)
            {
                <a class="nav-link @Active("PersonnelFiles")" asp-controller="PersonnelFiles" asp-action="Index">
                    <i class="fa-regular fa-folder-open"></i> Personnel files
                </a>
            }
            @GroupEnd(flat)
        }

        @* Reports and survey results are on the Administration page (11 November 2026). *@
        @if (adminLinks.Count > 0)
        {
            @* One page listing every administration screen this person may open (AdministrationController). *@
            <a class="nav-link @(inAdmin ? "active" : "")" asp-controller="Administration" asp-action="Index">
                <i class="fa-solid fa-gear"></i> Administration
            </a>
        }
    </nav>

    <div class="sidebar-footer">
        <div class="powered-by">GREL · Recruitment &amp; Selection</div>
    </div>
</aside>
