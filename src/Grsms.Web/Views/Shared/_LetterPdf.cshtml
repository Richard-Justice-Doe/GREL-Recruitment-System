@* 13 November 2026: the page printed to PDF by headless Chromium (Helpers/LetterPdfBuilder): one letter, self-contained. *@
@model Grsms.Web.Helpers.LetterPdfModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Title</title>
    <style>@Html.Raw(Model.Css)</style>
</head>
<body>
@if (Model.Draft)
{
    <div class="draft-mark" aria-hidden="true">DRAFT</div>
}
<partial name="@Model.PartialName" model="Model.Letter" />
</body>
</html>
