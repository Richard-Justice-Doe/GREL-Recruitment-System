@* Job adverts list with four tabs:
     Live      - running now, ending soonest first (with how many external channels are still to post)
     Scheduled - waiting for their start date, starting soonest first
     Drafts    - being prepared
     All       - every advert, newest first, with a status filter
   New adverts are created from a published vacancy's page. *@
@model PagedResult<AdvertListItemDto>
@{
    ViewData["Title"] = "Job adverts";
    var f = (AdvertFilter)ViewBag.Filter;
    var counts = (AdvertCounts)ViewBag.Counts;

    Dictionary<string, string> Route(int page)
    {
        var d = new Dictionary<string, string> { ["tab"] = f.Tab, ["page"] = page.ToString() };
        if (f.Status is { } s && f.Tab == "all") d["Status"] = s.ToString();
        if (f.Channel is { } c) d["Channel"] = c.ToString();
        if (f.DivisionId is { } div) d["DivisionId"] = div.ToString();
        if (f.DepartmentId is { } dep) d["DepartmentId"] = dep.ToString();
        if (f.From is { } from) d["From"] = from.ToString("yyyy-MM-dd");
        if (f.To is { } to) d["To"] = to.ToString("yyyy-MM-dd");
        if (!string.IsNullOrWhiteSpace(f.Search)) d["Search"] = f.Search;
        return d;
    }

    var tabs = new (string Key, string Label, int? Count, string BadgeCss)[]
    {
        ("live", "Live", counts.Live, "text-bg-success"),
        ("scheduled", "Scheduled", counts.Scheduled, "text-bg-warning"),
        ("draft", "Drafts", counts.Draft, "text-bg-secondary"),
        ("all", "All", null, ""),
    };
}

<div class="page-header">
    <div>
        <h1>Job adverts</h1>
        <p>Adverts for published vacancies, on the internal portal, the careers website, job sites and newspapers.</p>
    </div>
    <a asp-controller="Careers" asp-action="Index" class="btn btn-outline-secondary" target="_blank" rel="noopener">
        <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Open careers page
    </a>
</div>

@if (counts.ChannelsToPost > 0)
{
    <div class="alert alert-info small">
        <i class="fa-solid fa-circle-info me-1"></i>
        <strong>@counts.ChannelsToPost</strong> external channel@(counts.ChannelsToPost == 1 ? "" : "s") on live adverts still to post.
        Open the advert, copy the ready-made text into the site or send it to the newspaper, then record the link.
    </div>
}

<ul class="nav nav-pills mb-3 flex-wrap">
    @foreach (var t in tabs)
    {
        <li class="nav-item">
            <a class="nav-link @(f.Tab == t.Key ? "active" : "")" asp-action="Index" asp-route-tab="@t.Key">
                @t.Label
                @if (t.Count > 0)
                {
                    <span class="badge rounded-pill @t.BadgeCss ms-1">@t.Count</span>
                }
            </a>
        </li>
    }
</ul>

<form method="get" class="card glass mb-3">
    <input type="hidden" name="tab" value="@f.Tab" />
    <div class="card-body row g-2 align-items-end">
        <div class="col-sm-6 col-lg-3">
            <label class="form-label small" for="Search">Search</label>
            <input id="Search" name="Search" value="@f.Search" class="form-control" placeholder="Advert or vacancy number, title" />
        </div>
        <partial name="_ReportFilters" model="(f.DivisionId, f.DepartmentId, f.From, f.To)" />
        <div class="col-sm-6 col-lg-2">
            <label class="form-label small" for="Channel">Channel</label>
            <select id="Channel" name="Channel" class="form-select">
                <option value="">Any channel</option>
                @foreach (var c in Enum.GetValues<AdvertChannel>())
                {
                    <option value="@c" selected="@(f.Channel == c)">@c.DisplayName()</option>
                }
            </select>
        </div>
        @if (f.Tab == "all")
        {
            <div class="col-sm-6 col-lg-2">
                <label class="form-label small" for="Status">Status</label>
                <select id="Status" name="Status" class="form-select">
                    <option value="">Any status</option>
                    @foreach (var s in Enum.GetValues<AdvertStatus>())
                    {
                        <option value="@s" selected="@(f.Status == s)">@s.DisplayName()</option>
                    }
                </select>
            </div>
        }
        <div class="col-sm-6 col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-filter me-1"></i>Filter</button>
            <a asp-action="Index" asp-route-tab="@f.Tab" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

<div class="card glass">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                <tr><th>Advert no.</th><th>Title</th><th>Vacancy</th><th>Division</th><th>Department</th><th>Channels</th><th>Runs</th><th>Status</th></tr>
                </thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-body-secondary py-4">
                            No adverts here. To advertise a vacancy, open a <a asp-controller="Vacancies" asp-action="Index" asp-route-tab="open">published vacancy</a> and click <em>Create advert</em>.
                        </td>
                    </tr>
                }
                @foreach (var a in Model.Items)
                {
                    <tr>
                        <td class="text-nowrap"><a asp-action="Details" asp-route-id="@a.Id" class="fw-semibold text-decoration-none">@a.AdvertNumber</a></td>
                        <td>@a.Title</td>
                        <td class="text-nowrap"><a asp-controller="Vacancies" asp-action="Details" asp-route-id="@a.VacancyId" class="text-decoration-none">@a.VacancyNumber</a></td>
                        <td>@a.DivisionName</td>
                        <td>@a.DepartmentName</td>
                        <td class="small">
                            @string.Join(", ", a.Channels.Select(c => c.DisplayName()))
                            @if (a.ChannelsToPost > 0)
                            {
                                <span class="badge rounded-pill badge-soft-warning ms-1">@a.ChannelsToPost to post</span>
                            }
                        </td>
                        <td class="small text-nowrap">@a.StartDate.ToString("dd MMM") – @a.EndDate.ToString("dd MMM yyyy")</td>
                        <td><partial name="_StatusBadge" model="a.Status" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Pages">
            <span class="small text-body-secondary">@Model.TotalCount adverts · page @Model.Page of @Model.TotalPages</span>
            <div class="btn-group">
                <a class="btn btn-sm btn-outline-secondary @(Model.HasPrevious ? "" : "disabled")" asp-action="Index" asp-all-route-data="@Route(Model.Page - 1)">Previous</a>
                <a class="btn btn-sm btn-outline-secondary @(Model.HasNext ? "" : "disabled")" asp-action="Index" asp-all-route-data="@Route(Model.Page + 1)">Next</a>
            </div>
        </nav>
    </div>
</div>
