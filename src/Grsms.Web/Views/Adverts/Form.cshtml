@* Add/edit form for a job advert. The text starts from the vacancy and can be edited freely.
   Channels: the internal portal and company website are published automatically; the others get copy-ready text. *@
@model AdvertFormDto
@inject Grsms.Application.Ai.AdvertWriter Adverts
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Create advert" : "Edit advert";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
}

<div class="page-header">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>For vacancy <a asp-controller="Vacancies" asp-action="Details" asp-route-id="@Model.VacancyId">@Model.VacancyNumber</a> · @Model.VacancyTitle
            · closes @Model.VacancyClosingDate?.ToString("dd MMM yyyy")</p>
    </div>
    <a href="@(isNew ? Url.Action("Details", "Vacancies", new { id = Model.VacancyId }) : Url.Action("Details", new { id = Model.Id }))"
       class="btn btn-outline-secondary">Cancel</a>
</div>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" novalidate>
    <input type="hidden" asp-for="VacancyId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
    @if (Model.TakesOffline)
    {
        <div class="alert alert-warning small">
            <i class="fa-solid fa-triangle-exclamation me-1"></i><strong>This advert is published.</strong>
            Saving changes takes it offline and sends it back to the HR Manager and the IT Manager for approval.
        </div>
    }
    @if (Model.ReviewComment is not null && !Model.TakesOffline)
    {
        <div class="alert alert-info small"><i class="fa-solid fa-comment me-1"></i><strong>What to correct:</strong> <span style="white-space: pre-wrap">@Model.ReviewComment</span></div>
    }

    <div class="row g-3">
        <div class="col-xl-8">
            <div class="card glass">
                <div class="card-body p-4">
                    <h2 class="h6 text-uppercase text-body-secondary mb-3">Advert</h2>
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    @if (Adverts.IsOn)
                    {
                        @* docs/36 AI-1b: four versions from the vacancy; the person edits them; the advert still goes through HR review and IT approval. *@
                        <div class="ai-panel mb-3" data-ai-endpoint="@Url.Action("AdvertVersions", "Ai")" data-ai-collect="VacancyId,Title">
                            <div class="ai-panel-title"><i class="fa-solid fa-wand-magic-sparkles text-primary"></i>Write the advert with AI</div>
                            <p class="small text-body-secondary mb-2">Writes the careers-portal text, a job-board and newspaper version, an internal notice for staff and a LinkedIn post from the vacancy's description and requirements. The requirements are kept exactly as approved.</p>
                            <label for="ai-benefits" class="form-label small mb-1">Benefits to mention (optional)</label>
                            <textarea id="ai-benefits" class="form-control form-control-sm mb-2" rows="2" maxlength="2000" data-ai-field="benefits"
                                      placeholder="e.g. Medical cover, transport, staff housing on the estate"></textarea>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-sm btn-primary" data-ai-run><i class="fa-solid fa-wand-magic-sparkles me-1"></i>Write versions</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-ai-run data-ai-regenerate><i class="fa-solid fa-rotate me-1"></i>Another version</button>
                                <button type="button" class="btn btn-sm btn-success" data-ai-accept hidden><i class="fa-solid fa-check me-1"></i>Use these versions</button>
                            </div>
                            <div class="small mt-2" data-ai-status aria-live="polite"></div>
                            <div class="mt-2" data-ai-result></div>
                        </div>
                    }
                    <div class="mb-3">
                        <label asp-for="Body" class="form-label"></label>
                        <textarea asp-for="Body" class="form-control font-monospace small" rows="18" maxlength="10000"></textarea>
                        <div class="form-text">Pre-filled from the vacancy. Plain text: start lines with • for bullets. This is what applicants read.</div>
                        <span asp-validation-for="Body" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="HowToApply" class="form-label"></label>
                        <textarea asp-for="HowToApply" class="form-control" rows="3" maxlength="2000"></textarea>
                        <span asp-validation-for="HowToApply" class="text-danger small"></span>
                    </div>
                    @* docs/36 AI-1: optional versions for other channels (by hand or with AI). Empty = built from the advert text. *@
                    <details class="more-options mt-3" open="@(Model.ExternalText is not null || Model.LinkedInText is not null || Model.InternalNotice is not null)">
                        <summary class="fw-semibold">Versions for other channels (optional)</summary>
                        <p class="small text-body-secondary mt-2">Leave empty to use the advert text above. The apply link, closing date and reference are added automatically.</p>
                        <div class="mb-3">
                            <label asp-for="ExternalText" class="form-label"></label>
                            <textarea asp-for="ExternalText" class="form-control small" rows="8" maxlength="10000"></textarea>
                            <div class="form-text">Used for Indeed, Jobberman and newspapers.</div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="LinkedInText" class="form-label"></label>
                            <textarea asp-for="LinkedInText" class="form-control small" rows="6" maxlength="3000"></textarea>
                        </div>
                        <div>
                            <label asp-for="InternalNotice" class="form-label"></label>
                            <textarea asp-for="InternalNotice" class="form-control small" rows="6" maxlength="10000"></textarea>
                            <div class="form-text">Shown copy-ready on the advert page, for staff noticeboards or a staff email.</div>
                        </div>
                    </details>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card glass mb-3">
                <div class="card-body p-4">
                    <h2 class="h6 text-uppercase text-body-secondary mb-3">When</h2>
                    <div class="mb-3">
                        <label asp-for="StartDate" class="form-label"></label>
                        <input asp-for="StartDate" type="date" class="form-control" min="@today.ToString("yyyy-MM-dd")"
                               value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                        <div class="form-text">Today = live as soon as the IT Manager approves it. A later date = scheduled; it goes live by itself that day.</div>
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="EndDate" class="form-label"></label>
                        <input asp-for="EndDate" type="date" class="form-control" min="@today.ToString("yyyy-MM-dd")"
                               max="@Model.VacancyClosingDate?.ToString("yyyy-MM-dd")" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                        <div class="form-text">At the latest the vacancy's closing date. The advert closes by itself after this day.</div>
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card glass mb-3">
                <div class="card-body p-4">
                    <h2 class="h6 text-uppercase text-body-secondary mb-3">Channels</h2>
                    @if (Model.VacancyType == VacancyType.Internal)
                    {
                        <div class="alert alert-info small py-2">This vacancy is for GREL staff only, so only the internal portal is available.</div>
                    }
                    @foreach (var c in Enum.GetValues<AdvertChannel>())
                    {
                        var allowed = Model.AllowedChannels.Contains(c);
                        var auto = AdvertWorkflow.IsAutomatic(c);
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="Channels" value="@c" id="ch-@c"
                                   checked="@Model.Channels.Contains(c)" disabled="@(!allowed)" />
                            <label class="form-check-label @(allowed ? "" : "text-body-secondary")" for="ch-@c">
                                @c.DisplayName()
                                <span class="small text-body-secondary">· @(auto ? "published automatically" : "copy-ready text, posted by the IT Manager")</span>
                            </label>
                        </div>
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-floppy-disk me-1"></i>@(isNew ? "Save draft" : Model.TakesOffline ? "Save and send for approval" : "Save changes")</button>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
