@* 17 Nov 2026 (employee directory): a one-page employee report to print or save as PDF (the browser's Print). The same data and
   rules as the profile page; personal details only for HR (onboarding.view). *@
@model Grsms.Web.Models.EmployeeProfileViewModel
@{
    var e = Model.Employee;
    var x = Model.Extras;
    ViewData["Title"] = $"Employee report: {e.Name}";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    string D(DateOnly? d) => d?.ToString("d MMM yyyy") ?? "—";
}

<div class="page-header d-print-none">
    <div>
        <h1>Employee report</h1>
        <p>Print it, or choose "Save as PDF" in the print window.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-outline-secondary btn-back"><i class="fa-solid fa-arrow-left me-1"></i>Back to the profile</a>
        <button type="button" class="btn btn-outline-primary" data-print><i class="fa-solid fa-print me-1"></i>Print</button>
    </div>
</div>

<article class="card glass emp-report">
    <div class="card-body p-4 p-md-5">
        <partial name="_LetterHead" />
        <div class="d-flex gap-4 align-items-center mb-4">
            <partial name="_EmployeeAvatar" model='(e.Id, e.Name, x.HasPhoto, "xl")' />
            <div>
                <h2 class="mb-1">@e.Name</h2>
                <div>Employee ID <strong>@e.EmployeeNumber</strong> · @e.Status.DisplayName()</div>
                <div>@e.PositionTitle, @e.DepartmentName · @e.SiteName</div>
                <div class="small text-body-secondary">Profile @x.Completion.Percent% complete · report of @today.ToString("d MMMM yyyy")</div>
            </div>
        </div>

        <h3 class="h6 text-uppercase">Employment</h3>
        <table class="table table-sm mb-4">
            <tbody>
                <tr><th scope="row">Grade</th><td>@(e.GradeName ?? "—")</td><th scope="row">Contract</th><td>@e.EmploymentType.DisplayName()@(e.ContractEndDate is { } end ? $", until {end:d MMM yyyy}" : "")</td></tr>
                <tr><th scope="row">Joined</th><td>@D(e.HireDate) (@e.ServiceLength(today))</td><th scope="row">Confirmed</th><td>@(e.ConfirmationDate is null ? (e.Status == EmployeeStatus.OnProbation ? "On probation" : "—") : D(e.ConfirmationDate))</td></tr>
                <tr><th scope="row">Reports to</th><td>@(x.Team.Manager?.Name ?? "—")</td><th scope="row">Direct reports</th><td>@x.Team.Reports.Count</td></tr>
                <tr><th scope="row">Email</th><td>@(e.Email ?? "—")</td><th scope="row">Phone</th><td>@(e.Phone ?? "—")</td></tr>
            </tbody>
        </table>

        @if (Model.CanSeePersonal && Model.Personal is { Saved: true } p)
        {
            <h3 class="h6 text-uppercase">Personal</h3>
            <table class="table table-sm mb-4">
                <tbody>
                    <tr><th scope="row">Date of birth</th><td>@D(p.Form.DateOfBirth)</td><th scope="row">SSNIT</th><td>@(p.Form.SsnitNumber ?? "—")</td></tr>
                    <tr><th scope="row">Address</th><td colspan="3">@(p.Form.ResidentialAddress ?? "—")</td></tr>
                    <tr><th scope="row">Emergency contact</th><td colspan="3">@(p.Form.EmergencyContacts.FirstOrDefault() is { } ec ? $"{ec.Name} ({ec.Relationship}), {ec.Telephone1}" : "—")</td></tr>
                </tbody>
            </table>
        }

        <h3 class="h6 text-uppercase">Job history</h3>
        <table class="table table-sm mb-4">
            <thead><tr><th>From</th><th>To</th><th>Position</th><th>Department</th><th>Why</th></tr></thead>
            <tbody>
                @foreach (var h in e.History)
                {
                    <tr><td>@D(h.EffectiveFrom)</td><td>@(h.EffectiveTo is null ? "now" : D(h.EffectiveTo))</td><td>@h.PositionTitle</td><td>@h.DepartmentName</td><td>@h.Source.DisplayName()</td></tr>
                }
            </tbody>
        </table>

        @if (x.Completion.Missing.Count > 0 || x.Alerts.Count > 0)
        {
            <h3 class="h6 text-uppercase">Outstanding</h3>
            <ul class="mb-0">@foreach (var a in x.Alerts) { <li>@a.Text</li> }</ul>
        }
    </div>
</article>
