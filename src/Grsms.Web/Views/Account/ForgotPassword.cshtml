@* Step 1 of resetting a forgotten password: ask for the email address. *@
@model EmailOnlyViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}
<h1 class="h4 mb-1">Forgot your password?</h1>
<p class="text-body-secondary mb-4">Enter your email and we will send you a link to choose a new one.</p>

<form asp-action="ForgotPassword" method="post" novalidate>
    <div class="mb-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Send reset link</button>
</form>
<p class="small text-body-secondary mt-3 mb-0">Staff who sign in with Microsoft 365 should reset their password through GREL IT.</p>
<p class="text-center small mt-3 mb-0"><a asp-action="Login">Back to sign in</a></p>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
