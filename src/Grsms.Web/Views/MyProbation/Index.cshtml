@* Phase 21: the employee's own probation: dates, objectives and development plan (to sign), assessments, the outcome and
   the confirmation letter. *@
@model IReadOnlyList<ProbationDetailsDto>
@{
    ViewData["Title"] = "My probation";
}
<div class="page-header">
    <div>
        <h1>My probation</h1>
        <p>Your objectives, your assessments and the outcome of your probation.</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-secondary">You have no probation in GRSMS. It starts when your onboarding is completed.</div>
}
@foreach (var p in Model)
{
    <div class="card glass mb-3">
        <div class="card-body p-4 d-flex justify-content-between flex-wrap gap-2">
            <div>
                <h2 class="h5 mb-1">@p.JobTitle <span class="badge rounded-pill badge-soft-primary fs-6 align-middle">@p.Status.DisplayName()</span></h2>
                <p class="small mb-0">@p.Number · @p.DepartmentName · @p.StartDate.ToString("dd MMM yyyy") to <strong>@p.EndDate.ToString("dd MMM yyyy")</strong> ·
                    Head of Department: @(p.HodName ?? "—")</p>
            </div>
            @if (p.ConfirmationLetterDocumentId is not null)
            {
                <a asp-action="Letter" asp-route-id="@p.Id" class="btn btn-success align-self-start"><i class="fa-solid fa-file-signature me-1"></i>My confirmation letter</a>
            }
        </div>
    </div>

    @if (p.CanSignAsEmployee)
    {
        <div class="card glass mb-3 border border-primary">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-body-secondary mb-2">Please sign your objectives</h2>
                <p class="small">Your Head of Department has recorded your probation objectives and development plan (below). Read them, then sign.</p>
                <form asp-action="Sign" asp-route-id="@p.Id" method="post">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="confirm-@p.Id" name="confirm" value="true" />
                        <label class="form-check-label small" for="confirm-@p.Id">I have discussed and agree these objectives and this development plan.</label>
                    </div>
                    <div class="input-group" style="max-width: 32rem">
                        <input name="fullName" class="form-control" maxlength="200" required placeholder="Type your full name: @p.EmployeeName" aria-label="Your full name" />
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-signature me-1"></i>Sign</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <partial name="_ProbationRecord" model="p" />
}
