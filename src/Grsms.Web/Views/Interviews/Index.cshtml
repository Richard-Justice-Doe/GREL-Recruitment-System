@* Interviews and assessments:
     My panels         - sessions where I am on the panel
     Scorecards to do  - my sessions that have started and still need my scorecard
     To validate       - Recruitment Officers: sessions whose scores are all in and wait for validation (9 Nov 2026)
     Upcoming          - all scheduled sessions I may see (reviewers, HODs for their departments)
     All               - everything I may see, newest first *@
@model PagedResult<InterviewListItemDto>
@inject AccessScope Scope
@{
    ViewData["Title"] = "Interviews";
    var f = (InterviewFilter)ViewBag.Filter;
    var pending = (int)ViewBag.PendingScorecards;
    var toValidate = (int)(ViewBag.ToValidate ?? 0);
    var seesOthers = Scope.SeesAllDepartments || User.IsInRole(Roles.HeadOfDepartment);

    Dictionary<string, string> Route(int page)
    {
        var d = new Dictionary<string, string> { ["tab"] = f.Tab, ["page"] = page.ToString() };
        if (f.Status is { } s && f.Tab == "all") d["Status"] = s.ToString();
        if (f.DivisionId is { } div) d["DivisionId"] = div.ToString();
        if (f.DepartmentId is { } dep) d["DepartmentId"] = dep.ToString();
        if (f.VacancyId is { } vac) d["VacancyId"] = vac.ToString();
        if (f.From is { } from) d["From"] = from.ToString("yyyy-MM-dd");
        if (f.To is { } to) d["To"] = to.ToString("yyyy-MM-dd");
        return d;
    }

    var tabs = new List<(string Key, string Label, int? Count)> { ("mine", "My panels", null), ("scorecards", "Scorecards to do", pending) };
    if (User.IsInRole(Roles.RecruitmentOfficer)) tabs.Add(("validate", "To validate", toValidate));
    if (seesOthers)
    {
        tabs.Add(("upcoming", "Upcoming", null));
        tabs.Add(("all", "All", null));
    }
}

<div class="page-header">
    <div>
        <h1>Interviews and assessments</h1>
        <p>Sessions with shortlisted applicants, their panels and scorecards.</p>
    </div>
</div>

<ul class="nav nav-pills mb-3 flex-wrap">
    @foreach (var t in tabs)
    {
        <li class="nav-item">
            <a class="nav-link @(f.Tab == t.Key ? "active" : "")" asp-action="Index" asp-route-tab="@t.Key">
                @t.Label
                @if (t.Count > 0) { <span class="badge rounded-pill text-bg-danger ms-1">@t.Count</span> }
            </a>
        </li>
    }
</ul>

@if (seesOthers)
{
    <form method="get" class="card glass mb-3">
        <input type="hidden" name="tab" value="@f.Tab" />
        <div class="card-body row g-2 align-items-end">
            <partial name="_ReportFilters" model="(f.DivisionId, f.DepartmentId, f.From, f.To)" />
            @if (f.Tab == "all")
            {
                <div class="col-sm-6 col-lg-2">
                    <label class="form-label small" for="Status">Status</label>
                    <select id="Status" name="Status" class="form-select">
                        <option value="">Any status</option>
                        @foreach (var s in Enum.GetValues<InterviewStatus>())
                        {
                            <option value="@s" selected="@(f.Status == s)">@s.DisplayName()</option>
                        }
                    </select>
                </div>
            }
            <div class="col-sm-6 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-filter me-1"></i>Filter</button>
                <a asp-action="Index" asp-route-tab="@f.Tab" class="btn btn-outline-secondary">Clear</a>
            </div>
        </div>
    </form>
}

<div class="card glass">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                <tr><th>When (GMT)</th><th>Applicant</th><th>Vacancy</th><th>Session</th><th>Where</th><th class="text-center">Scorecards</th><th>Average</th><th>Status</th></tr>
                </thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-body-secondary py-4">@(f.Tab == "scorecards" ? "No scorecards waiting for you. 🎉" : "No interview sessions here. Schedule one from a candidate's application.")</td></tr>
                }
                @foreach (var i in Model.Items)
                {
                    <tr>
                        <td class="text-nowrap"><a asp-action="Details" asp-route-id="@i.Id" class="fw-semibold text-decoration-none">@i.StartsAt.ToString("ddd dd MMM yyyy, HH:mm")</a></td>
                        <td>@i.ApplicantName</td>
                        <td>@i.VacancyNumber<div class="small text-body-secondary">@i.JobTitle · @i.DepartmentName</div></td>
                        <td class="small">Round @i.Round · @i.Type.DisplayName()<div class="text-body-secondary">@i.Mode.DisplayName()</div></td>
                        <td class="small text-break">@i.Location</td>
                        <td class="text-center">@i.ScorecardsIn / @i.PanelSize</td>
                        <td>@(i.AverageScore is decimal avg ? avg.ToString("0.0") : "—")</td>
                        <td><span class="badge rounded-pill @(i.Status == InterviewStatus.Scheduled ? "badge-soft-primary" : i.Status == InterviewStatus.AwaitingValidation ? "badge-soft-warning" : i.Status == InterviewStatus.Completed ? "badge-soft-success" : "badge-soft-secondary")">@i.Status.DisplayName()</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Pages">
            <span class="small text-body-secondary">@Model.TotalCount sessions · page @Model.Page of @Model.TotalPages</span>
            <div class="btn-group">
                <a class="btn btn-sm btn-outline-secondary @(Model.HasPrevious ? "" : "disabled")" asp-action="Index" asp-all-route-data="@Route(Model.Page - 1)">Previous</a>
                <a class="btn btn-sm btn-outline-secondary @(Model.HasNext ? "" : "disabled")" asp-action="Index" asp-all-route-data="@Route(Model.Page + 1)">Next</a>
            </div>
        </nav>
    </div>
</div>
