@* Same message whether or not the email has an account (prevents account "fishing"). *@
@{
    ViewData["Title"] = "Check your email";
    Layout = "_AuthLayout";
}
<div class="text-center">
    <i class="fa-solid fa-envelope fa-3x text-primary mb-3"></i>
    <h1 class="h4">Check your email</h1>
    <p class="text-body-secondary">If an active account uses that address, a password reset link is on its way. The link can be used once.</p>
    <a asp-action="Login" class="btn btn-primary">Back to sign in</a>
</div>
