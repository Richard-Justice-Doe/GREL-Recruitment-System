@{
    ViewData["Title"] = "Password changed";
    Layout = "_AuthLayout";
}
<div class="text-center">
    <i class="fa-solid fa-circle-check fa-3x text-success mb-3"></i>
    <h1 class="h4">Password changed</h1>
    <p class="text-body-secondary">You can now sign in with your new password.</p>
    <a asp-action="Login" class="btn btn-primary">Sign in</a>
</div>
