@* Phase 14: add or rename a custom role (Super Admin only). Its permissions are ticked on the Roles & permissions grid. *@
@model RoleFormDto
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "Add custom role" : $"Edit role {Model.Name}";
}

<div class="page-header">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</div>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
    <div class="card glass" style="max-width: 640px">
        <div class="card-body p-4">
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Recruitment Auditor" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            @if (!isNew)
            {
                <p class="small text-body-secondary mb-0">People who hold this role keep it under the new name; their access follows within 5 minutes.</p>
            }
        </div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Save</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
