@* Friendly error page shown in production when something unexpected goes wrong.
   The Request ID lets IT find the full error in the log files (logs/grsms-*.log). *@
@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    Layout = "_AuthLayout";
}

<div class="text-center">
    <i class="fa-solid fa-triangle-exclamation fa-3x text-warning mb-3"></i>
    <h1 class="h4">Something went wrong</h1>
    <p class="text-body-secondary">Sorry, we could not complete your request. Please try again. If it keeps happening, contact IT and quote the reference below.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small">Reference: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" href="~/">Back to home</a>
</div>
